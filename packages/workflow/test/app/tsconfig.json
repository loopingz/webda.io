{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Decorators"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "./lib",
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
