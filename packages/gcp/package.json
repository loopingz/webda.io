{
  "name": "@webda/gcp",
  "version": "4.0.0-beta.14",
  "description": "Webda GCP Services implementation",
  "main": "lib/index.js",
  "scripts": {
    "build": "webdac build",
    "build:watch": "webdac build --watch",
    "pretest": "npm run build",
    "codemod": "jscodeshift --parser=ts --extensions=tsx,ts -t ../codemod/current.mjs src",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "bench": "vitest run --config vitest.bench.config.ts",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "deps:graph": "skott --showCircularDependencies --no-trackTypeOnlyDependencies --displayMode=raw -e .ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/gcp"
  },
  "keywords": [
    "webda",
    "modda"
  ],
  "files": [
    "lib",
    "webda.module.json",
    "package.json"
  ],
  "author": "abalam666",
  "license": "LGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/loopingz/webda.io/issues"
  },
  "homepage": "https://github.com/loopingz/webda.io#readme",
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "@google-cloud/kms": "^6.3.0",
    "@google-cloud/pubsub": "^6.3.2",
    "@google-cloud/storage": "~8.4.0",
    "@webda/core": "workspace:*",
    "@webda/ql": "workspace:*",
    "@webda/utils": "workspace:*",
    "mime-types": "^3.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@webda/bench": "workspace:*",
    "@webda/compiler": "workspace:^",
    "@webda/test": "workspace:*",
    "jscodeshift": "^17.4.0",
    "skott": "^0.35.12",
    "typescript": "7.1.0-dev.20261102.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "nx": {
    "implicitDependencies": [
      "@webda/core"
    ]
  }
}
