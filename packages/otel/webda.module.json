{
  "$schema": "https://webda.io/schemas/webda.module.v4.json",
  "beans": {},
  "deployers": {},
  "moddas": {
    "Webda/OtelService": {
      "Import": "lib/otel.service:OtelService",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "loggerExporter#2": {
            "additionalProperties": false,
            "description": "Logger export\nIf empty it is disabled\n\nValues (url, headers...) can be encrypted with `webda config encrypt`",
            "properties": {
              "enable": {
                "default": true,
                "description": "Allow to disable the logger",
                "type": "boolean"
              },
              "type": {
                "const": "otlp",
                "type": "string"
              },
              "url": {
                "default": "http://localhost:4317",
                "description": "Can be encrypted with `webda config encrypt` (when it holds credentials)",
                "type": "string",
                "x-webda-secret": true
              }
            },
            "type": "object"
          },
          "metricExporter#2": {
            "additionalProperties": false,
            "properties": {
              "enable": {
                "default": true,
                "description": "Allow to disable the metric exporter",
                "type": "boolean"
              },
              "type": {
                "enum": [
                  "console",
                  "otlp"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          "traceExporter": {
            "additionalProperties": false,
            "default": {
              "enable": true,
              "sampling": 0.01,
              "type": "otlp"
            },
            "description": "Trace export configuration",
            "properties": {
              "enable": {
                "default": true,
                "description": "Allow to disable the trace exporter",
                "type": "boolean"
              },
              "sampling": {
                "default": 0.01,
                "description": "Between 0.0 and 1.0",
                "type": "number"
              },
              "type": {
                "enum": [
                  "console",
                  "otlp"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          "webTracing#2": {
            "additionalProperties": false,
            "description": "On-demand web tracing: an authorized user gets a short-lived token, the browser sends it as\n`X-Webda-Trace` to have its `traceparent` and `baggage` honored",
            "properties": {
              "allowedEmails": {
                "description": "Emails allowed to enable web tracing, as regular expressions matching the whole email\n(`\"*\"` means any authenticated user). Empty or missing means nobody.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "duration": {
                "default": 900,
                "description": "Token lifetime in seconds",
                "type": "number"
              }
            },
            "type": "object"
          }
        },
        "description": "OpenTelemetry service parameters",
        "properties": {
          "diagnostic": {
            "default": "NONE",
            "enum": [
              "NONE",
              "ERROR",
              "WARN",
              "INFO",
              "DEBUG",
              "TRACE",
              "ALL"
            ],
            "type": "string"
          },
          "loggerExporter": {
            "$ref": "#/definitions/loggerExporter%232",
            "description": "Logger export\nIf empty it is disabled\n\nValues (url, headers...) can be encrypted with `webda config encrypt`"
          },
          "metricExporter": {
            "$ref": "#/definitions/metricExporter%232"
          },
          "name": {
            "description": "Service name reported to OpenTelemetry, default to the package name",
            "type": "string"
          },
          "traceExporter": {
            "$ref": "#/definitions/traceExporter",
            "default": {
              "enable": true,
              "sampling": 0.01,
              "type": "otlp"
            },
            "description": "Trace export configuration"
          },
          "trustedTraceSources": {
            "default": [],
            "description": "Sources (IP or CIDR) whose `traceparent` and `baggage` are always honored",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "webTracing": {
            "$ref": "#/definitions/webTracing%232",
            "description": "On-demand web tracing: an authorized user gets a short-lived token, the browser sends it as\n`X-Webda-Trace` to have its `traceparent` and `baggage` honored"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "type"
        ],
        "type": "object",
        "title": "OtelService"
      },
      "Configuration": "lib/otel.service:OtelServiceParameters"
    }
  },
  "models": {},
  "schemas": {
    "Webda/BinaryFile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "WebdaSchema": true,
      "additionalProperties": false,
      "description": "Represent a file to store",
      "properties": {
        "hash": {
          "description": "Will be computed by the service\n\nhash of the content",
          "type": "string"
        },
        "metadata": {
          "description": "Metadatas stored along with the binary"
        },
        "mimetype": {
          "description": "Mimetype of the binary",
          "type": "string"
        },
        "name": {
          "description": "Current name",
          "type": "string"
        },
        "originalname": {
          "description": "Original name",
          "type": "string"
        },
        "size": {
          "description": "Size of the binary",
          "type": "number"
        }
      },
      "required": [
        "mimetype",
        "name",
        "size"
      ],
      "type": "object",
      "title": "BinaryFile"
    },
    "OtelService.enableWebTracing.input": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        }
      },
      "x-webda-rest": {
        "method": "post",
        "template": "otel/tracing",
        "path": [],
        "query": [],
        "body": [
          "sessionId"
        ]
      }
    },
    "OtelService.enableWebTracing.output": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "expiresAt": {
          "type": "number"
        },
        "sessionId": {
          "type": "string"
        },
        "token": {
          "type": "string"
        }
      },
      "required": [
        "expiresAt",
        "sessionId",
        "token"
      ],
      "type": "object"
    }
  },
  "behaviors": {}
}