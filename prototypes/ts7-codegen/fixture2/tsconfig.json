{
  "compilerOptions": {
    "target": "ES2022", "module": "nodenext", "moduleResolution": "nodenext",
    "strict": true, "strictPropertyInitialization": false,
    "declaration": true, "outDir": "./lib", "rootDir": "./src",
    "useDefineForClassFields": true, "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
