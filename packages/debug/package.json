{
  "name": "@webda/debug",
  "version": "4.0.0-beta.15",
  "description": "Development debug server for Webda applications",
  "keywords": [
    "webda",
    "debug"
  ],
  "author": "Remi Cattiau <remi@cattiau.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/debug"
  },
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "webdac build && vite build --config vite.webui.config.ts",
    "build:watch": "webdac build --watch",
    "pretest": "npm run build",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:debug": "vitest debug",
    "test:coverage": "vitest run --coverage",
    "build:webui": "vite build --config vite.webui.config.ts",
    "prepack": "node scripts/check-webui.mjs"
  },
  "dependencies": {
    "@webda/utils": "workspace:*",
    "@webda/workout": "workspace:*",
    "terminal-kit": "^3.1.4",
    "ws": "^8.22.1"
  },
  "peerDependencies": {
    "@webda/core": "^4.0.0-beta.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@webda/compiler": "workspace:^",
    "@webda/core": "workspace:^",
    "@webda/debug-ui": "workspace:*",
    "@webda/test": "workspace:*",
    "jscodeshift": "^17.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "7.1.0-dev.20261102.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "files": [
    "lib",
    "webui",
    "webda.module.json"
  ],
  "homepage": "https://webda.io",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "LGPL-3.0-only"
}
