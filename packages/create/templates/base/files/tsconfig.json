{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": false,
    "sourceMap": true,
    "declaration": true,
    "experimentalDecorators": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declarationMap": true
  },
  "include": ["src/**/*", ".webda/module.d.ts"],
  "exclude": ["**/node_modules", "**/*.spec.ts"]
}
