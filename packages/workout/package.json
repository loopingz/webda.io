{
  "name": "@webda/workout",
  "version": "4.0.0-beta.7",
  "description": "Abstraction to logging and user interaction",
  "keywords": [
    "terminal",
    "logger"
  ],
  "author": "Remi Cattiau <remi@cattiau.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/workout"
  },
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "deps:graph": "skott --showCircularDependencies --no-trackTypeOnlyDependencies --displayMode=raw -e .ts"
  },
  "dependencies": {
    "sprintf-js": "^1.1.3",
    "yoctocolors": "^2.2.0"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "26.6.6",
    "@types/sprintf-js": "^1.1.4",
    "c8": "^12.0.0",
    "mock-stdin": "^1.0.0",
    "prettier": "^3.9.10",
    "sinon": "^22.1.0",
    "skott": "^0.35.12",
    "source-map-support": "^0.5.21",
    "typescript": "7.1.0-dev.20261102.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "files": [
    "lib"
  ],
  "c8": {
    "report-dir": "./reports",
    "reporter": [
      "html",
      "lcov",
      "json",
      "text"
    ],
    "exclude": [
      "**/*.spec.ts",
      "lib/**",
      "src/index.ts",
      "src/fork.ts"
    ]
  },
  "homepage": "https://webda.io",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "LGPL-3.0-only",
  "optionalDependencies": {
    "@inquirer/prompts": "^8.7.5"
  }
}
