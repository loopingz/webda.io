{
  "$schema": "https://webda.io/schemas/webda.module.v4.json",
  "beans": {},
  "deployers": {},
  "moddas": {
    "Webda/GoogleAuthentication": {
      "Import": "lib/google-auth.service:default",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "redirects": {
            "additionalProperties": false,
            "properties": {
              "defaults": {
                "$ref": "#/definitions/redirects%24defaults"
              },
              "use_referer": {
                "default": false,
                "type": "boolean"
              },
              "whitelist": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "defaults",
              "whitelist"
            ],
            "type": "object"
          },
          "redirects$defaults": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "description": "Credentials to manage Google Auth\nhttps://developers.google.com/identity/protocols/oauth2",
        "properties": {
          "access_type": {
            "description": "Type of access for Google token\n\nonline by default",
            "enum": [
              "online",
              "offline"
            ],
            "type": "string"
          },
          "auth_options": {},
          "authenticationService": {
            "default": "Authentication",
            "description": "Name of the authentication service to use if exist",
            "type": "string"
          },
          "authorized_uris": {
            "default": [],
            "description": "List of URIs authorized for redirect post authorization",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "client_id": {
            "description": "Google Auth Client id",
            "type": "string"
          },
          "client_secret": {
            "description": "Google Auth Client secret",
            "type": "string"
          },
          "exposeScope": {
            "default": false,
            "description": "If set to true it will add a ${url}/scope\nSo client can anticipate the requested scope\n\nThis is useful when using the client api to generate\ntoken. This way the service can request the wanted scope",
            "type": "boolean"
          },
          "no_referer": {
            "default": false,
            "description": "Allow direct connection without a referer",
            "type": "boolean"
          },
          "project_id": {
            "description": "Google Project ID",
            "type": "string"
          },
          "redirect_uri": {
            "default": "${url}/callback",
            "description": "Default redirect_uri",
            "type": "string"
          },
          "redirects": {
            "$ref": "#/definitions/redirects"
          },
          "scope": {
            "defaut": [
              "email"
            ],
            "description": "Scope to request on OAuth flow",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "url": {
            "SchemaOptional": true,
            "description": "URL to use for expose\n\nThe default value varying based on implementation\nIt should by default be the provider name in lowercase",
            "type": "string"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "client_id",
          "client_secret",
          "scope",
          "type"
        ],
        "type": "object",
        "title": "GoogleAuthentication"
      },
      "Configuration": "lib/google-auth.service:GoogleParameters",
      "capabilities": [
        "request-filter"
      ]
    }
  },
  "models": {},
  "schemas": {
    "Webda/BinaryFile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "WebdaSchema": true,
      "additionalProperties": false,
      "description": "Represent a file to store",
      "properties": {
        "challenge": {
          "description": "Will be computed by the service\n\nhash of the content prefixed by 'WEBDA'",
          "type": "string"
        },
        "hash": {
          "description": "Will be computed by the service\n\nhash of the content",
          "type": "string"
        },
        "metadata": {
          "description": "Metadatas stored along with the binary"
        },
        "mimetype": {
          "description": "Mimetype of the binary",
          "type": "string"
        },
        "name": {
          "description": "Current name",
          "type": "string"
        },
        "originalname": {
          "description": "Original name",
          "type": "string"
        },
        "size": {
          "description": "Size of the binary",
          "type": "number"
        }
      },
      "required": [
        "mimetype",
        "name",
        "size"
      ],
      "type": "object",
      "title": "BinaryFile"
    }
  },
  "behaviors": {},
  "sourceDigest": "81b6772d117dc6b9ebee0610f20e64ac"
}