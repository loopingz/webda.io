{
  "name": "@webda/decorators",
  "version": "4.0.0-beta.5",
  "description": "Decorators utils",
  "keywords": [],
  "author": "Remi Cattiau <remi@cattiau.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/decorators"
  },
  "main": "lib/decorator.js",
  "exports": {
    "default": "./lib/decorator.js"
  },
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "deps:graph": "skott --showCircularDependencies --no-trackTypeOnlyDependencies --displayMode=raw -e .ts",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "pretest": "tsc",
    "precommit": "eslint --fix && prettier --write src/**/*",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:debug": "vitest debug",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "skott": "^0.35.8",
    "typescript": "7.1.0-dev.20260929.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.2"
  },
  "files": [
    "lib"
  ],
  "homepage": "https://webda.io",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "LGPL-3.0-only"
}
