    "Webda/S3Binary": {
      "Import": "lib/services/s3binary.service:S3Binary",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "credentials": {
            "additionalProperties": false,
            "description": "Static credentials, default to the AWS environment variables",
            "properties": {
              "accessKeyId": {
                "type": "string"
              },
              "secretAccessKey": {
                "type": "string"
              },
              "sessionToken": {
                "type": "string"
              }
            },
            "required": [
              "accessKeyId",
              "secretAccessKey"
            ],
            "type": "object"
          },
          "models": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "Define the map of models\n* indicates all models\n\nkey is a Store name\nthe string[] represent all valids attributes to store files in * indicates all attributes",
            "type": "object"
          }
        },
        "description": "S3Binary parameters",
        "properties": {
          "CloudFormation": {
            "description": "CloudFormation customization"
          },
          "CloudFormationSkip": {
            "default": false,
            "description": "Skip CloudFormation on deploy",
            "type": "boolean"
          },
          "bucket": {
            "description": "Bucket to store the binaries in",
            "type": "string"
          },
          "credentials": {
            "$ref": "#/definitions/credentials",
            "description": "Static credentials, default to the AWS environment variables"
          },
          "endpoint": {
            "description": "Custom endpoint (localstack, minio, ...)",
            "type": "string"
          },
          "forcePathStyle": {
            "default": false,
            "description": "Use path style url (required by localstack/minio)",
            "type": "boolean"
          },
          "maxFileSize": {
            "default": "10 MB",
            "description": "Define the maximum filesize to accept as direct upload\nGet the max file size in bytes",
            "returns": "the result number",
            "type": "number"
          },
          "models": {
            "$ref": "#/definitions/models",
            "description": "Define the map of models\n* indicates all models\n\nkey is a Store name\nthe string[] represent all valids attributes to store files in * indicates all attributes"
          },
          "prefix": {
            "type": "string"
          },
          "region": {
            "default": "us-east-1",
            "description": "AWS region",
            "type": "string"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "bucket",
          "models",
          "type"
        ],
        "type": "object",
        "title": "S3Binary"
      },
      "Configuration": "lib/services/s3binary.service:S3BinaryParameters"
    },
    "Webda/SQSQueue": {
      "Import": "lib/services/sqsqueue.service:default",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "WaitDelayerDefinition": {
            "additionalProperties": false,
            "description": "Configuration object for selecting and parameterizing a `WaitDelayer` from the registry.",
            "properties": {
              "interval": {
                "description": "Base interval in milliseconds passed to the delayer factory.",
                "type": "number"
              },
              "type": {
                "description": "Key identifying the factory in `WaitDelayerFactories.registry` (e.g. `\"linear\"`, `\"exponential\"`).",
                "type": "string"
              }
            },
            "required": [
              "interval",
              "type"
            ],
            "type": "object"
          },
          "credentials": {
            "additionalProperties": false,
            "description": "Static credentials, default to the AWS environment variables",
            "properties": {
              "accessKeyId": {
                "type": "string"
              },
              "secretAccessKey": {
                "type": "string"
              },
              "sessionToken": {
                "type": "string"
              }
            },
            "required": [
              "accessKeyId",
              "secretAccessKey"
            ],
            "type": "object"
          }
        },
        "description": "SQS Queue parameters",
        "properties": {
          "CloudFormation": {
            "description": "Any additional CloudFormation parameters"
          },
          "CloudFormationSkip": {
            "default": false,
            "description": "Skip CloudFormation on deploy",
            "type": "boolean"
          },
          "MessageGroupId": {
            "description": "MessageGroupId to pass to send and receive",
            "type": "string"
          },
          "WaitTimeSeconds": {
            "default": 20,
            "description": "Time to wait pending for an item",
            "type": "number"
          },
          "credentials": {
            "$ref": "#/definitions/credentials",
            "description": "Static credentials, default to the AWS environment variables"
          },
          "endpoint": {
            "description": "Custom endpoint (localstack, minio, ...)",
            "type": "string"
          },
          "maxConsumers": {
            "default": 10,
            "description": "Max number of queue consumers\nQueue will auto increase to this max number if queue is loaded\nand it will decrease to just one consumer if no messages are available",
            "type": "number"
          },
          "queue": {
            "default": "",
            "description": "Queue URL",
            "type": "string"
          },
          "region": {
            "default": "us-east-1",
            "description": "AWS region",
            "type": "string"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "workerDelayer": {
            "$ref": "#/definitions/WaitDelayerDefinition",
            "description": "Delayer between two failed attempts to process messages"
          },
          "workerParallelism": {
            "default": true,
            "description": "Define if worker should process multi message received in //",
            "type": "boolean"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "type"
        ],
        "type": "object",
        "title": "SQSQueue"
      },
      "Configuration": "lib/services/sqsqueue.service:SQSQueueParameters"
    }
  },
