{
  "name": "@webda/offline",
  "version": "4.0.0-beta.7",
  "description": "Offline replicas of Webda models with revision-checked sync and 3-way merge conflicts",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "node": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "import": "./lib/client/index.js"
    },
    "./protocol": {
      "types": "./lib/protocol/index.d.ts",
      "import": "./lib/protocol/index.js"
    }
  },
  "scripts": {
    "build": "webdac build",
    "build:watch": "webdac build --watch",
    "pretest": "npm run build",
    "test": "vitest run",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "keywords": [
    "webda-module",
    "offline",
    "sync"
  ],
  "files": [
    "lib",
    "webda.module.json",
    "package.json"
  ],
  "dependencies": {
    "@webda/core": "workspace:*",
    "@webda/models": "workspace:*",
    "@webda/ql": "workspace:*",
    "@webda/versioning": "workspace:*",
    "@webda/workout": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@webda/compiler": "workspace:^",
    "@webda/test": "workspace:*",
    "fake-indexeddb": "^6.0.0",
    "typescript": "7.1.0-dev.20260929.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.2"
  },
  "bugs": {
    "url": "https://github.com/loopingz/webda.io/issues"
  },
  "homepage": "https://github.com/loopingz/webda.io#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/offline"
  },
  "publishConfig": {
    "access": "public"
  },
  "webda": {
    "namespace": "Webda"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "LGPL-3.0-only"
}
