{
  "name": "@webda/otel",
  "version": "4.0.0-beta.12",
  "description": "OpenTelemetry module",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "build": "webdac build",
    "pretest": "npm run build",
    "test": "vitest run",
    "new-model": "webda init webda:model",
    "new-service": "webda init webda:service",
    "format": "prettier --check src/**/*",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format:fix": "prettier --write src/**/*",
    "deps:graph": "skott --showCircularDependencies --no-trackTypeOnlyDependencies --displayMode=raw -e .ts",
    "codemod": "jscodeshift --parser=ts --extensions=tsx,ts -t ../codemod/current.mjs src",
    "build:watch": "webdac build --watch"
  },
  "keywords": [
    "webda-module"
  ],
  "files": [
    "lib",
    "webda.module.json",
    "package.json"
  ],
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@webda/core": "workspace:*",
    "@webda/workout": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@webda/compiler": "workspace:^",
    "@webda/test": "workspace:*",
    "jscodeshift": "^17.4.0",
    "prettier": "^3.9.10",
    "skott": "^0.35.12",
    "typescript": "7.1.0-dev.20261102.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/loopingz/webda.io/issues"
  },
  "homepage": "https://github.com/loopingz/webda.io#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/otel"
  },
  "license": "LGPL-3.0-only",
  "engines": {
    "node": ">=22.0.0"
  }
}
