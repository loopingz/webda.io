              }
            },
            "type": "object"
          },
          "Context": {
            "additionalProperties": false,
            "type": "object"
          },
          "K8sConfiguration": {
            "additionalProperties": false,
            "description": "Kubernetes configuration as found in a kubeconfig file",
            "properties": {
              "clusters": {
                "items": {
                  "$ref": "#/definitions/Cluster"
                },
                "type": "array"
              },
              "contexts": {
                "items": {
                  "$ref": "#/definitions/Context"
                },
                "type": "array"
