{
  "$schema": ".webda/config.schema.json",
  "$import": ["./webda.import.jsonc", "./webda.import2.jsonc", "./webda.import4.jsonc"],
  "version": 3,
  "services": {
    "memorylogger": {
      "type": "MemoryLogger"
    },
    "images": {
      "type": "FileBinary",
      "folder": "./data/images",
      "models": { "*": ["*"] },
    },
    "thumbnailsqueue": {
      "type": "MemoryQueue"
    },
    // Contact store
    "contacts": {
      "model": "WebdaDemo/Contact",
      "type": "MemoryStore",
      "table": "local-table"
    },
    // User store: the keys behavior of a user holds its public keys, escrows and keyring
    "users": {
      "model": "WebdaDemo/User",
      "type": "MemoryStore"
    },
    // Note store: the content of a note is sealed to its owner
    "notes": {
      "model": "WebdaDemo/Note",
      "type": "MemoryStore"
    },
    "DomainService": {
      "type": "DomainService"
    },
    "RESTService": {
      "type": "RESTOperationsTransport"
    },
    "CryptoService": {
      "type": "Webda/CryptoService",
      "autoCreate": true
    }
  },
  "parameters": {
    "trustedProxies": "127.0.0.1, ::1"
  }
}
