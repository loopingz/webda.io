  "devDependencies": {
    "@types/node": "26.6.6",
    "@webda/compiler": "workspace:^",
    "@webda/test": "workspace:*",
    "c8": "^12.0.0",
    "fs-extra": "^11.4.1",
    "jscodeshift": "^17.4.0",
    "prettier": "^3.9.10",
    "sinon": "^22.1.0",
    "skott": "^0.35.12",
    "source-map-support": "^0.5.21",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-dev.20261102.1",
