                "upsert",
                "delete"
              ],
              "type": "string"
            },
            "rev": {
              "description": "Revision after the write, when known",
              "type": "number"
            },
            "seq": {
              "description": "Sortable sequence: zero-padded epoch ms, per-process counter, instance id",
              "type": "string"
            },
            "subjectKey": {
              "description": "Canonical primary key (`serializeSubjectKey`)",
              "type": "string"
            },
            "subjectModel": {
              "description": "Model identifier, e.g. `MyApp/Task`",
              "type": "string"
            },
            "timestamp": {
              "description": "Time of the write",
              "format": "date-time",
              "type": "string"
            },
            "uuid": {
              "description": "UUID of the model",
              "format": "uuid",
              "type": "string"
            }
