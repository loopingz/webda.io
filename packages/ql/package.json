{
  "name": "@webda/ql",
  "version": "4.0.0-beta.9",
  "description": "WebdaQL module",
  "keywords": [
    "webda"
  ],
  "author": "Remi Cattiau <remi@cattiau.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/ql"
  },
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "grammar": "antlr4ts -visitor src/WebdaQLLexer.g4 src/WebdaQLParser.g4 && node ../../scripts/add-import-extensions.mjs src && pnpm run lint:fix",
    "pretest": "npm run build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "deps:graph": "skott --showCircularDependencies --no-trackTypeOnlyDependencies --displayMode=raw -e .ts -ig 'src/Webda*.ts'",
    "codemod": "jscodeshift --parser=ts --extensions=tsx,ts -t ../codemod/current.mjs src"
  },
  "dependencies": {
    "@webda/utils": "workspace:*",
    "antlr4-c3": "3.1.1",
    "antlr4ts": "0.5.0-alpha.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@webda/test": "workspace:^",
    "antlr4ts-cli": "0.5.0-alpha.4",
    "c8": "^12.0.0",
    "jscodeshift": "^17.4.0",
    "prettier": "^3.9.10",
    "sinon": "^22.1.0",
    "skott": "^0.35.12",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-dev.20261102.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "files": [
    "lib"
  ],
  "homepage": "https://webda.io",
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "implicitDependencies": [
      "@webda/workout"
    ]
  },
  "webda": {
    "namespace": "Webda"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "LGPL-3.0-only"
}
