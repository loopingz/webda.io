{
  "$schema": "https://webda.io/schemas/webda.module.v4.json",
  "beans": {},
  "deployers": {},
  "moddas": {
    "Webda/ReactEmailService": {
      "Import": "lib/react-email.service:ReactEmailService",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "Record<string, string>": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Construct a type with a set of properties K of type T",
            "type": "object"
          }
        },
        "description": "Parameters of the {@link ReactEmailService}",
        "properties": {
          "fixApostrophes": {
            "default": true,
            "description": "Replace `&#x27;` by `'` in the html",
            "type": "boolean"
          },
          "output": {
            "default": "./templates",
            "description": "Folder where the mustache templates are written, relative to the working directory",
            "type": "string"
          },
          "pretty": {
            "default": true,
            "description": "Pretty print the html",
            "type": "boolean"
          },
          "source": {
            "default": "./emails",
            "description": "Folder containing the emails, relative to the working directory",
            "type": "string"
          },
          "sourceMap": {
            "$ref": "#/definitions/Record%3Cstring%2C%20string%3E",
            "description": "Source to compiled prefix map, for example `{ \"emails/\": \"lib/emails/\" }`"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "type"
        ],
        "type": "object",
        "title": "ReactEmailService"
      },
      "Configuration": "lib/react-email.service:ReactEmailParameters",
      "commands": {
        "build": {
          "description": "Precompile react-email templates to mustache",
          "method": "build",
          "args": {},
          "phase": "resolved"
        },
        "react-email build": {
          "description": "Precompile react-email templates to mustache",
          "method": "buildTemplates",
          "args": {
            "source": {
              "type": "string",
              "default": "./emails",
              "alias": "s",
              "description": "Folder of the email components"
            },
            "output": {
              "type": "string",
              "default": "./templates",
              "alias": "o",
              "description": "Folder of the generated mustache templates"
            },
            "pretty": {
              "type": "boolean",
              "default": true,
              "description": "Format the generated html"
            }
          },
          "phase": "application"
        }
      }
    }
  },
  "models": {},
  "schemas": {
    "Webda/BinaryFile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "WebdaSchema": true,
      "additionalProperties": false,
      "description": "Represent a file to store",
      "properties": {
        "hash": {
          "description": "Will be computed by the service\n\nhash of the content",
          "type": "string"
        },
        "metadata": {
          "description": "Metadatas stored along with the binary"
        },
        "mimetype": {
          "description": "Mimetype of the binary",
          "type": "string"
        },
        "name": {
          "description": "Current name",
          "type": "string"
        },
        "originalname": {
          "description": "Original name",
          "type": "string"
        },
        "size": {
          "description": "Size of the binary",
          "type": "number"
        }
      },
      "required": [
        "mimetype",
        "name",
        "size"
      ],
      "type": "object",
      "title": "BinaryFile"
    }
  },
  "behaviors": {}
}