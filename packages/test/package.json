{
  "name": "@webda/test",
  "version": "4.0.0-beta.8",
  "description": "Test for NodeJS projects",
  "keywords": [],
  "author": "Remi Cattiau <remi@cattiau.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/test"
  },
  "main": "lib/index.js",
  "exports": {
    "default": "./lib/index.js"
  },
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "deps:graph": "skott --showCircularDependencies --no-trackTypeOnlyDependencies --displayMode=raw -e .ts",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "pretest": "tsc",
    "precommit": "eslint --fix && prettier --write src/**/*",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:debug": "vitest debug",
    "test:coverage": "vitest run --coverage",
    "test:mocha": "mocha --node-option import=tsx 'src/**/*.spec.ts'",
    "test:jest": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:bun": "bun test",
    "codemod": "jscodeshift --parser=ts --extensions=tsx,ts -t ../codemod/current.mjs src"
  },
  "dependencies": {
    "@webda/decorators": "workspace:^",
    "@webda/workout": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jscodeshift": "^17.4.0",
    "mocha": "^12.0.3",
    "skott": "^0.35.12",
    "tsx": "^4.23.15",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "files": [
    "lib"
  ],
  "homepage": "https://webda.io",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "LGPL-3.0-only",
  "peerDependencies": {
    "vitest": "^4.1.2 || ^5.1.0"
  }
}
