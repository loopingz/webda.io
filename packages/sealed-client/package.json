{
  "name": "@webda/sealed-client",
  "version": "4.0.0-beta.14",
  "description": "Client KeyVault for Webda sealed (end-to-end encrypted) fields: holds the user keyring on a device and opens sealed values",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "pretest": "npm run build",
    "test": "vitest run",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "keywords": [
    "webda",
    "e2ee",
    "sealed",
    "webcrypto"
  ],
  "files": [
    "lib",
    "package.json"
  ],
  "dependencies": {
    "@webda/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "fake-indexeddb": "^6.2.7",
    "typescript": "7.1.0-dev.20261102.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "bugs": {
    "url": "https://github.com/loopingz/webda.io/issues"
  },
  "homepage": "https://github.com/loopingz/webda.io#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/sealed-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "LGPL-3.0-only"
}
