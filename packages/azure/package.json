{
  "name": "@webda/azure",
  "version": "4.0.0-beta.15",
  "description": "Azure services and deployers for Webda",
  "main": "lib/index.js",
  "scripts": {
    "build": "webdac build",
    "build:watch": "webdac build --watch",
    "pretest": "npm run build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/azure"
  },
  "keywords": [
    "webda",
    "modda"
  ],
  "files": [
    "lib",
    "webda.module.json",
    "package.json"
  ],
  "author": "loopingz",
  "license": "LGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/loopingz/webda.io/issues"
  },
  "homepage": "https://github.com/loopingz/webda.io#readme",
  "dependencies": {
    "@azure/arm-resources": "^8.0.0",
    "@azure/arm-resourcesdeployments": "^2.0.0",
    "@azure/core-auth": "^1.11.0",
    "@azure/cosmos": "^4.10.1",
    "@azure/functions": "^4.17.0",
    "@azure/identity": "^4.14.1",
    "@azure/keyvault-keys": "^4.10.2",
    "@azure/keyvault-secrets": "^4.12.0",
    "@azure/monitor-ingestion": "^1.2.0",
    "@azure/service-bus": "^7.10.0",
    "@azure/storage-blob": "^12.34.0",
    "@webda/core": "workspace:*",
    "@webda/models": "workspace:*",
    "@webda/oci": "workspace:*",
    "@webda/ql": "workspace:*",
    "@webda/utils": "workspace:*",
    "@webda/workout": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@webda/compiler": "workspace:^",
    "@webda/test": "workspace:*",
    "typescript": "7.1.0-dev.20261102.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "nx": {
    "implicitDependencies": [
      "@webda/core"
    ]
  },
  "typings": "lib/index.d.ts",
  "webda": {
    "namespace": "Webda"
  }
}
