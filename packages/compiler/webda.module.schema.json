      "type": "string"
    },
    "ModelGraph": {
      "additionalProperties": false,
      "description": "Defined relationship for one model",
      "properties": {
        "ancestors": {
          "description": "Model names of the parent of the parent, etc...",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "behaviors": {
          "description": "Behavior attributes — properties whose type is a class marked with `@Behavior()`. The Behavior class is referenced by Identifier so that the Behavior's actions can be looked up in the top-level `behaviors` map of the module.",
          "items": {
            "$ref": "#/definitions/ModelGraphBehaviorDefinition"
          },
          "type": "array"
        },
        "binaries": {
          "description": "Binaries attribute, in the model you can declare attributes as Binary, so users can upload binaries that will be linked to this object with some metadata",
          "items": {
            "$ref": "#/definitions/ModelGraphBinaryDefinition"
          },
          "type": "array"
        },
        "children": {
          "description": "References to every model that declare this model as a parent",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "links": {
          "description": "This contains links to other models. These links are low cardinality as ids and their selected attributes are stored in the current model.",
          "items": {
            "$ref": "#/definitions/ModelRelation"
          },
          "type": "array"
        },
        "maps": {
          "description": "Maps are deduplication of data in your model They are managed automatically by a service like `ModelMapper`\n\nThey are useful in NoSQL environment like DynamoDB or Firebase",
          "items": {
            "additionalProperties": false,
            "properties": {
              "attribute": {
                "description": "Attribute in the model",
                "type": "string"
              },
              "cascadeDelete": {
                "type": "boolean"
              },
              "model": {
                "description": "Target model",
                "type": "string"
              },
              "targetAttributes": {
                "description": "Target model attributes to duplicate",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "targetLink": {
                "type": "string"
              }
            },
            "required": [
              "attribute",
              "model",
              "targetAttributes",
              "targetLink",
              "cascadeDelete"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "parent": {
          "additionalProperties": false,
          "description": "If the model has a parent",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          },
          "required": [
            "attribute",
            "model"
          ],
          "type": "object"
        },
        "polymorphicLinks": {
          "description": "Polymorphic references; absent models means any registered target. No cascade is implied.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "attribute": {
                "type": "string"
              },
              "models": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "attribute"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "queries": {
          "description": "Target other models with a new query This is usually our foreign keys\n\nThis will generate queries for you: SELECT * FROM 'model' WHERE 'targetAttribute' = 'this[attribute]'",
          "items": {
            "additionalProperties": false,
            "properties": {
              "attribute": {
                "description": "Attribute in the model",
                "type": "string"
              },
              "model": {
                "description": "Targeted model",
                "type": "string"
              },
              "targetAttribute": {
                "description": "Targeted model attribute",
                "type": "string"
              }
            },
            "required": [
              "attribute",
              "model",
              "targetAttribute"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ModelGraphBehaviorDefinition": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "description": "Property name on the parent model.",
          "type": "string"
        },
        "behavior": {
          "description": "Identifier of the Behavior class (e.g. \"Webda/MFA\").",
          "type": "string"
        }
      },
      "required": [
        "attribute",
        "behavior"
      ],
      "type": "object"
    },
    "ModelGraphBinaryDefinition": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "type": "string"
        },
        "cardinality": {
          "enum": [
            "ONE",
            "MANY"
          ],
          "type": "string"
        },
        "metadata": {
          "type": "string"
        }
      },
      "required": [
        "attribute",
        "cardinality"
      ],
      "type": "object"
    },
    "ModelMetadata": {
      "additionalProperties": false,
      "properties": {
        "Actions": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "global": {
                "description": "If true, the action is global (static method) rather than per-instance",
                "type": "boolean"
              },
              "handler": {
                "description": "Method implementing the action, when exposed under another name with `@Action({ name })`",
                "type": "string"
              },
              "maxMfaAge": {
                "description": "Require the second factor to be verified within this duration (Duration syntax), see `OperationDefinition.maxMfaAge`",
                "type": [
                  "number",
                  "string"
                ]
              },
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "rest": {
                "additionalProperties": false,
                "description": "Behavior-only: per-action REST hint that overrides the default `{prefix}/{uuid}/{attribute}.{actionName}` PUT mapping.\n\n- `route === \".\"` → URL is the bare attribute path   `{prefix}/{uuid}/{attribute}`.\n- `route === \"<suffix>\"` → URL is   `{prefix}/{uuid}/{attribute}/<suffix>`. Path templates such as   `\"{hash}\"` or `\"{index}/{hash}\"` are passed through unchanged so   the router treats them as path variables.\n- `route === undefined` → URL falls back to the dot-notation default.\n\n`method` defaults to `\"PUT\"`.",
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "route": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "summary": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "description": "Actions defined for the model",
          "type": "object"
        },
        "Aliases": {
          "description": "Former identifiers of the model, from its `@WebdaAlias` tags (namespace-completed)\n\nRows stored under one of them are read as this model. Absent when the model has none: the runtime defaults it to an empty list.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "Ancestors": {
          "description": "Ancestors of the model\n\nOrdered from the closest to the farest CoreModel is ignored\n\nclass Test extends Parent extends GrandParent extends CoreModel [\"Parent\", \"GrandParent\"]",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "Configuration": {
          "description": "Export of the model's Parameters class.",
          "type": "string"
        },
        "Events": {
          "description": "Return all events for the model",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "Identifier": {
          "description": "Model identifier",
          "type": "string"
        },
        "Import": {
          "description": "File to import",
          "type": "string"
        },
        "Plural": {
          "description": "Specific plurals for a model",
          "type": "string"
        },
        "PrimaryKey": {
          "description": "Return the primary key",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "PrimaryKeySeparator": {
          "description": "Separator for the primary key to serialize it",
          "type": "string"
        },
        "Reflection": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "type": {
                "type": "string"
              },
              "typeParameters": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "type",
              "required"
            ],
            "type": "object"
          },
          "description": "Fields reflection",
          "type": "object"
        },
        "Relations": {
          "$ref": "#/definitions/ModelGraph",
          "description": "Models graph\n\nTypescript does not have reflection, we therefore deduct the relations on compilation time and inject in the module\n\nThe parent is define by a ModelParent type on the model The links are attribute of types ModelLink"
        },
        "Schema": {
          "$ref": "#/definitions/JSONSchema7",
          "description": "Typed runtime parameter schema, separate from instance schemas."
        },
        "Schemas": {
          "additionalProperties": false,
          "description": "Schemas defining the model",
          "properties": {
            "Input": {
              "$ref": "#/definitions/JSONSchema7",
              "description": "Schema for input validation"
            },
            "Output": {
              "$ref": "#/definitions/JSONSchema7",
              "description": "Schema for output validation"
            },
            "Stored": {
              "$ref": "#/definitions/JSONSchema7",
              "description": "Schema for stored data validation"
            }
          },
          "type": "object"
        },
        "Shared": {
          "additionalProperties": {
            "$ref": "#/definitions/SharedMethodMetadata"
          },
          "description": "Methods marked `@Shared()`: copied into the frontend SDK by `@webda/sdk`\n\nOnly present when the model declares some.",
          "type": "object"
        },
        "ShortName": {
          "description": "If model have a short name",
          "type": "string"
        },
        "Subclasses": {
          "description": "Direct Subclasses of the model",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "Identifier",
        "Import",
        "Plural",
        "Schemas",
        "Relations",
        "Ancestors",
        "Subclasses",
        "PrimaryKey",
        "Events",
        "Reflection",
        "Actions"
      ],
      "type": "object"
    },
    "ModelRelation": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "type": {
          "enum": [
            "LINK",
            "LINKS_MAP",
            "LINKS_ARRAY",
            "LINKS_SIMPLE_ARRAY"
          ],
          "type": "string"
        }
      },
      "required": [
        "attribute",
        "model",
        "type"
      ],
      "type": "object"
    },
    "ServiceMetadata": {
      "additionalProperties": false,
      "properties": {
        "Configuration": {
          "description": "Configuration for the service",
          "type": "string"
        },
        "Import": {
          "description": "File to import",
          "type": "string"
        },
        "Schema": {
          "$ref": "#/definitions/JSONSchema7",
          "description": "Schema defining the service"
        },
        "capabilities": {
          "description": "Capability names provided by this service, detected at compile-time.\n\nThe compiler inspects which interfaces the service class implements. If an interface has a `@WebdaCapability <name>` JSDoc tag, that name is added to this array. At runtime, the framework uses these to auto-discover services (e.g., registering request filters with the Router).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "commands": {
          "additionalProperties": {
            "$ref": "#/definitions/CommandDefinition"
          },
          "description": "CLI commands declared via `@Command` decorator on service methods.\n\nKeys are command names (space-separated for subcommands, e.g., `\"aws s3\"`). Values describe the command handler and its arguments.",
          "type": "object"
        }
      },
      "required": [
        "Import"
      ],
      "type": "object"
    },
    "SharedMethodMetadata": {
      "additionalProperties": false,
      "description": "A model method shared with the frontend SDK (`@Shared()`)",
      "properties": {
        "imports": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
