{
  "$schema": ".webda/config.schema.json",
  "parameters": {
    "locales": ["en-US"],
    "website": "https://localhost:18080"
  },
  "services": {
    "HttpServer": {
      "type": "Webda/HttpServer",
      "autoTls": true
    },
    "HttpServerH2c": {
      "type": "Webda/HttpServer",
      "port": 50051,
      "h2c": true
    },
    "Publisher": {
      "type": "Publisher"
    },
    "Mailer": {
      "type": "Webda/Mailer"
    },
    "DomainService": {
      "type": "Webda/DomainService"
    },
    "AuditService": {
      "type": "Webda/AuditService",
      "level": "write",
      "readPermission": "TRUE",
      "exposeReadOperations": true
    },
    "RESTService": {
      "type": "Webda/RESTOperationsTransport"
    },
    "GRPCService": {
      "type": "Webda/GrpcService"
    },
    "MCP": {
      "type": "Webda/McpService"
    },
    "GraphQLService": {
      "type": "Webda/GraphQLService"
    },
    "WebUI": {
      "type": "Webda/ResourceService",
      "folder": "./webui",
      "url": "/admin",
      "rootRedirect": true
    },
    "CryptoService": {
      "type": "Webda/CryptoService",
      "autoCreate": true
    },
    "PostStore": {
      "type": "Webda/MemoryStore",
      "models": ["WebdaSample/Post"],
      "persistence": { "path": "./data/posts" }
    },
    "TagStore": {
      "type": "Webda/MemoryStore",
      "models": ["WebdaSample/Tag"],
      "persistence": { "path": "./data/tags" }
    },
    "PostTagStore": {
      "type": "Webda/MemoryStore",
      "models": ["WebdaSample/PostTag"],
      "persistence": { "path": "./data/post-tags" }
    },
    "UserFollowStore": {
      "type": "Webda/MemoryStore",
      "models": ["WebdaSample/UserFollow"],
      "persistence": { "path": "./data/user-follows" }
    },
    "Images": {
      "type": "Webda/FileBinary",
      "folder": "./data/images",
      "url": "/binaries",
      "models": { "*": ["*"] }
    }
  }
}
