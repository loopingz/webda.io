{
  "name": "@webda/graphql",
  "version": "4.0.0-beta.15",
  "description": "GraphQL endpoint for your Webda Application",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "build": "webdac build",
    "pretest": "npm run build",
    "test": "vitest run",
    "new-model": "webda init webda:model",
    "new-service": "webda init webda:service",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "deps:graph": "skott --showCircularDependencies --no-trackTypeOnlyDependencies --displayMode=raw -e .ts",
    "codemod": "jscodeshift --parser=ts --extensions=tsx,ts -t ../codemod/current.mjs src"
  },
  "keywords": [
    "webda-module"
  ],
  "files": [
    "lib",
    "webda.module.json",
    "package.json"
  ],
  "dependencies": {
    "@webda/core": "workspace:*",
    "@webda/ql": "workspace:*",
    "@webda/runtime": "workspace:*",
    "@webda/utils": "workspace:*",
    "@webda/workout": "workspace:*",
    "graphql": "^17.0.2",
    "graphql-http": "^1.23.1",
    "graphql-ws": "^6.4.1",
    "json-schema": "^0.4.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@webda/compiler": "workspace:^",
    "@webda/test": "workspace:^",
    "c8": "^12.0.0",
    "glob": "^14.0.3",
    "js-beautify": "^2.0.3",
    "jscodeshift": "^17.4.0",
    "prettier": "^3.9.10",
    "skott": "^0.35.12",
    "source-map-support": "^0.5.21",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "webda": {
    "namespace": "Webda"
  },
  "bugs": {
    "url": "https://github.com/loopingz/webda.io/issues"
  },
  "homepage": "https://github.com/loopingz/webda.io#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/graphql"
  },
  "license": "LGPL-3.0-only",
  "nx": {
    "implicitDependencies": [
      "@webda/core",
      "@webda/shell"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
