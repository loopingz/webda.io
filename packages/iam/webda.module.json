  "moddas": {
    "Webda/IAMService": {
      "Import": "lib/iam.service:IAMService",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "PolicyDocument": {
            "additionalProperties": false,
            "description": "An IAM policy document",
            "properties": {
              "description": {
                "description": "Human description",
                "type": "string"
              },
              "name": {
                "description": "Unique policy name",
                "type": "string"
              },
              "statements": {
                "description": "Statements of the policy",
                "items": {
                  "$ref": "#/definitions/PolicyStatement"
                },
                "type": "array"
              }
            },
            "required": [
              "name",
              "statements"
            ],
            "type": "object"
          },
          "PolicyStatement": {
            "additionalProperties": false,
            "description": "One statement of a policy",
            "properties": {
              "condition": {
                "description": "Casbin expression over `r.ctx`; omitted means always",
                "type": "string"
              },
              "effect": {
                "description": "Allow or deny: a matching deny wins",
                "enum": [
                  "allow",
                  "deny"
                ],
                "type": "string"
              },
              "operations": {
                "description": "Glob patterns on operation ids: \"Tasks.*\", \"*.Get\", \"*\"",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "sid": {
                "description": "Optional statement identifier",
                "type": "string"
              }
            },
            "required": [
              "effect",
              "operations"
            ],
            "type": "object"
          },
          "Record<string, string[]>": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "Construct a type with a set of properties K of type T",
            "type": "object"
          }
        },
        "inheritdoc": true,
        "properties": {
          "attachments": {
            "$ref": "#/definitions/Record%3Cstring%2C%20string%5B%5D%3E",
            "description": "Principal to policy names"
          },
          "policies": {
            "description": "Policies defined in configuration (read-only)",
            "items": {
              "$ref": "#/definitions/PolicyDocument"
            },
            "type": "array"
          },
          "reloadDelay": {
            "default": 100,
            "description": "Debounce of a rebuild after a model change, in ms",
            "type": "number"
          },
          "reloadInterval": {
            "default": 300,
            "description": "Periodic rebuild, in seconds; 0 disables",
            "type": "number"
          },
          "scope": {
            "default": [
              "*"
            ],
            "description": "Operation id globs governed by IAM",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "attachments",
          "policies",
          "type"
        ],
        "type": "object",
        "title": "IAMService"
      },
      "Configuration": "lib/iam.service:IAMServiceParameters"
    }
  },
