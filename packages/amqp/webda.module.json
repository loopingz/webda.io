{
  "$schema": "https://webda.io/schemas/webda.module.v4.json",
  "beans": {},
  "deployers": {},
  "moddas": {
    "Webda/AMQPPubSub": {
      "Import": "lib/pubsub.service:default",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "exchange": {
            "additionalProperties": false,
            "properties": {
              "alternateExchange": {
                "description": "an exchange to send messages to if this exchange can’t route them to any queues.\n\nSpecific to RabbitMQ",
                "type": "string"
              },
              "arguments": {
                "description": "any additional arguments that may be needed by an exchange"
              },
              "autoDelete": {
                "default": false,
                "description": "if true, the exchange will be destroyed once the number of bindings for which it is the source drop to zero.",
                "type": "boolean"
              },
              "durable": {
                "default": true,
                "description": "if true, the exchange will survive broker restarts.",
                "type": "boolean"
              },
              "internal": {
                "default": false,
                "description": "if true, messages cannot be published directly to the exchange\n(i.e., it can only be the target of bindings, or possibly create messages ex-nihilo).",
                "type": "boolean"
              },
              "type": {
                "default": "fanout",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "description": "Configuration for {@link AMQPPubSubService}",
        "properties": {
          "channel": {
            "description": "Exchange name to publish to and consume from",
            "type": "string"
          },
          "exchange": {
            "$ref": "#/definitions/exchange"
          },
          "subscription": {
            "default": "",
            "description": "Queue name used to subscribe, empty to let the broker generate one",
            "type": "string"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "url": {
            "description": "AMQP connection url",
            "example": "amqp://localhost:5672",
            "type": "string"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "channel",
          "type",
          "url"
        ],
        "type": "object",
        "title": "AMQPPubSubService"
      },
      "Configuration": "lib/pubsub.service:AMQPPubSubParameters"
    },
    "Webda/AMQPQueue": {
      "Import": "lib/queue.service:default",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "WaitDelayerDefinition": {
            "additionalProperties": false,
            "description": "Configuration object for selecting and parameterizing a `WaitDelayer` from the registry.",
            "properties": {
              "interval": {
                "description": "Base interval in milliseconds passed to the delayer factory.",
                "type": "number"
              },
              "type": {
                "description": "Key identifying the factory in `WaitDelayerFactories.registry` (e.g. `\"linear\"`, `\"exponential\"`).",
                "type": "string"
              }
            },
            "required": [
              "interval",
              "type"
            ],
            "type": "object"
          }
        },
        "description": "Configuration for {@link AMQPQueue}",
        "properties": {
          "maxConsumers": {
            "default": 10,
            "description": "Max number of queue consumers\nQueue will auto increase to this max number if queue is loaded\nand it will decrease to just one consumer if no messages are available",
            "type": "number"
          },
          "queue": {
            "description": "Queue name",
            "type": "string"
          },
          "queueOptions": {
            "description": "Options passed to assertQueue"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "url": {
            "description": "AMQP connection url",
            "example": "amqp://localhost:5672",
            "type": "string"
          },
          "workerDelayer": {
            "$ref": "#/definitions/WaitDelayerDefinition",
            "description": "Delayer between two failed attempts to process messages"
          },
          "workerParallelism": {
            "default": true,
            "description": "Define if worker should process multi message received in //",
            "type": "boolean"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "queue",
          "type",
          "url"
        ],
        "type": "object",
        "title": "AMQPQueue"
      },
      "Configuration": "lib/queue.service:AMQPQueueParameters"
    }
  },
  "models": {},
  "schemas": {
    "Webda/BinaryFile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "WebdaSchema": true,
      "additionalProperties": false,
      "description": "Represent a file to store",
      "properties": {
        "challenge": {
          "description": "Will be computed by the service\n\nhash of the content prefixed by 'WEBDA'",
          "type": "string"
        },
        "hash": {
          "description": "Will be computed by the service\n\nhash of the content",
          "type": "string"
        },
        "metadata": {
          "description": "Metadatas stored along with the binary"
        },
        "mimetype": {
          "description": "Mimetype of the binary",
          "type": "string"
        },
        "name": {
          "description": "Current name",
          "type": "string"
        },
        "originalname": {
          "description": "Original name",
          "type": "string"
        },
        "size": {
          "description": "Size of the binary",
          "type": "number"
        }
      },
      "required": [
        "mimetype",
        "name",
        "size"
      ],
      "type": "object",
      "title": "BinaryFile"
    }
  },
  "behaviors": {},
  "sourceDigest": "e0ae809a55ff53610dabe20c85e656bb"
}