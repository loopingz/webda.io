{
  "$schema": "https://webda.io/schemas/webda.module.v4.json",
  "beans": {},
  "deployers": {},
  "moddas": {
    "Webda/SyncService": {
      "Import": "lib/server/sync.service:SyncService",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "description": "Parameters of the SyncService",
        "properties": {
          "maxMutations": {
            "default": 100,
            "description": "Maximum mutations accepted per Sync.Push request (clients batch with `pushBatchSize`, 100 by default)",
            "type": "number"
          },
          "maxQueryLength": {
            "default": 1024,
            "description": "Maximum length of a scope query",
            "type": "number"
          },
          "maxScopes": {
            "default": 20,
            "description": "Maximum scopes per request",
            "type": "number"
          },
          "models": {
            "description": "Models clients can sync; each must implement `Syncable`",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "overlap": {
            "default": "5s",
            "description": "Window re-read by the next pull, covering clock skew between servers",
            "type": "string"
          },
          "pageSize": {
            "default": 500,
            "description": "Maximum change-log entries or objects returned per Sync.Pull / Sync.Snapshot page",
            "type": "number"
          },
          "retention": {
            "default": "30d",
            "description": "How long change-log entries are kept; older cursors trigger a resync",
            "type": "string"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "watchDebounce": {
            "default": 250,
            "description": "Debounce of the watch hints, in milliseconds",
            "type": "number"
          },
          "watchKeepAlive": {
            "default": 25000,
            "description": "Interval of the heartbeats yielded by an idle Sync.Watch, in milliseconds (0 disables them).\nThey let the transport notice a closed client and release the watcher.",
            "type": "number"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "models",
          "type"
        ],
        "type": "object",
        "title": "SyncService"
      },
      "Configuration": "lib/server/sync.service:SyncServiceParameters"
    }
  },
  "models": {
