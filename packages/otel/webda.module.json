{
  "$schema": "https://webda.io/schemas/webda.module.v4.json",
  "beans": {},
  "deployers": {},
  "moddas": {
    "Webda/OtelService": {
      "Import": "lib/otel.service:OtelService",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "loggerExporter": {
            "additionalProperties": false,
            "description": "Logger export\nIf empty it is disabled",
            "properties": {
              "enable": {
                "default": true,
                "description": "Allow to disable the logger",
                "type": "boolean"
              },
              "type": {
                "const": "otlp",
                "type": "string"
              },
              "url": {
                "default": "http://localhost:4317",
                "type": "string"
              }
            },
            "type": "object"
          },
          "metricExporter": {
            "additionalProperties": false,
            "properties": {
              "enable": {
                "default": true,
                "description": "Allow to disable the metric exporter",
                "type": "boolean"
              },
              "type": {
                "enum": [
                  "console",
                  "otlp"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          "traceExporter": {
            "additionalProperties": false,
            "properties": {
              "enable": {
                "default": true,
                "description": "Allow to disable the trace exporter",
                "type": "boolean"
              },
              "sampling": {
                "default": 0.01,
                "description": "Between 0.0 and 1.0",
                "type": "number"
              },
              "type": {
                "enum": [
                  "console",
                  "otlp"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          }
        },
        "description": "OpenTelemetry service parameters",
        "properties": {
          "diagnostic": {
            "default": "NONE",
            "enum": [
              "NONE",
              "ERROR",
              "WARN",
              "INFO",
              "DEBUG",
              "TRACE",
              "ALL"
            ],
            "type": "string"
          },
          "loggerExporter": {
            "$ref": "#/definitions/loggerExporter",
            "description": "Logger export\nIf empty it is disabled"
          },
          "metricExporter": {
            "$ref": "#/definitions/metricExporter"
          },
          "name": {
            "description": "Service name reported to OpenTelemetry, default to the package name",
            "type": "string"
          },
          "traceExporter": {
            "$ref": "#/definitions/traceExporter"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "type"
        ],
        "type": "object",
        "title": "OtelService"
      },
      "Configuration": "lib/otel.service:OtelServiceParameters"
    }
  },
  "models": {},
  "schemas": {
    "Webda/BinaryFile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "WebdaSchema": true,
      "additionalProperties": false,
      "description": "Represent a file to store",
      "properties": {
        "challenge": {
          "description": "Will be computed by the service\n\nhash of the content prefixed by 'WEBDA'",
          "type": "string"
        },
        "hash": {
          "description": "Will be computed by the service\n\nhash of the content",
          "type": "string"
        },
        "metadata": {
          "description": "Metadatas stored along with the binary"
        },
        "mimetype": {
          "description": "Mimetype of the binary",
          "type": "string"
        },
        "name": {
          "description": "Current name",
          "type": "string"
        },
        "originalname": {
          "description": "Original name",
          "type": "string"
        },
        "size": {
          "description": "Size of the binary",
          "type": "number"
        }
      },
      "required": [
        "mimetype",
        "name",
        "size"
      ],
      "type": "object",
      "title": "BinaryFile"
    }
  },
  "behaviors": {},
  "sourceDigest": "e1095c81ddf59a6192faa2b99e0bc389"
}