{
  "name": "@webda/runtime",
  "version": "4.0.0-beta.12",
  "description": "@webda runtime services",
  "keywords": [],
  "author": "Remi Cattiau <remi@cattiau.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/runtime"
  },
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "webdac build",
    "build:watch": "webdac build --watch",
    "pretest": "npm run build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "echo 'Tests disabled — spec files need migration from @testdeck/mocha to @webda/test'",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "deps:graph": "skott --showCircularDependencies --no-trackTypeOnlyDependencies --displayMode=raw -e .ts",
    "codemod": "jscodeshift --parser=ts --extensions=tsx,ts -t ../codemod/current.mjs src"
  },
  "dependencies": {
    "@types/json-schema": "^7.0.15",
    "@webda/core": "workspace:*",
    "@webda/models": "workspace:*",
    "@webda/ql": "workspace:*",
    "@webda/workout": "workspace:*",
    "accept-language": "^3.0.20",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "antlr4ts": "0.5.0-alpha.4",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "dateformat": "^5.0.5",
    "deepmerge-ts": "^8.0.2",
    "glob": "^14.0.3",
    "global": "^4.4.0",
    "json-schema": "^0.4.0",
    "jsonc-parser": "^3.3.1",
    "jsonpath": "^1.3.0",
    "jsonwebtoken": "^9.0.3",
    "merge": "^2.1.1",
    "mime-types": "^3.0.2",
    "node-cron": "^4.6.0",
    "node-machine-id": "^1.1.12",
    "openapi-types": "^12.1.3",
    "password-prompt": "^1.1.3",
    "pem-jwk": "^2.0.0",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.18.1",
    "semver": "^7.8.6",
    "stream-buffers": "^3.0.3",
    "ts-method-cache": "^3.3.1",
    "uri-templates": "^0.2.0",
    "yaml": "^2.9.1"
