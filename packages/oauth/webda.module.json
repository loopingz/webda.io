{
  "$schema": "https://webda.io/schemas/webda.module.v4.json",
  "beans": {},
  "deployers": {},
  "moddas": {
    "Webda/OAuthServer": {
      "Import": "lib/oauthserver.service:OAuthServer",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "Record<string, Omit<OAuthClient, \"id\"> | null>": {
            "additionalProperties": {
              "anyOf": [
                {
                  "const": null,
                  "type": "null"
                },
                {
                  "$ref": "#/definitions/clients%24%5Bkey%3A%20string%5D%232"
                }
              ]
            },
            "description": "Construct a type with a set of properties K of type T",
            "type": "object"
          },
          "clients$[key: string]#2": {
            "additionalProperties": false,
            "description": "Construct a type with the properties of T except for those in type K.",
            "properties": {
              "allowedScopes": {
                "description": "Maximum scope ever granted",
                "type": "string"
              },
              "client_uri": {
                "description": "Home page",
                "type": "string"
              },
              "defaultScope": {
                "description": "Scope when the request has none",
                "type": "string"
              },
              "deviceFlow": {
                "default": false,
                "description": "Device authorization grant allowed",
                "type": "boolean"
              },
              "logo": {
                "description": "Logo URL",
                "type": "string"
              },
              "metadataDocument": {
                "default": false,
                "description": "Loaded from a Client ID Metadata Document",
                "type": "boolean"
              },
              "name": {
                "description": "Display name",
                "type": "string"
              },
              "redirect_uris": {
                "description": "Allowed redirect URIs; loopback http URIs match any port",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "name",
              "redirect_uris"
            ],
            "type": "object"
          }
        },
        "description": "OAuthServer parameters",
        "properties": {
          "accessTtl": {
            "description": "Access token lifetime (s); defaults to TokenService",
            "type": "number"
          },
          "clientMetadataCacheTtl": {
            "default": 3600,
            "type": "number"
          },
          "clientMetadataDocuments": {
            "default": true,
            "type": "boolean"
          },
          "clientMetadataHosts": {
            "description": "Hosts allowed to serve Client ID Metadata Documents.\nEmpty (default): any public host is accepted. Non-empty: only these hosts are accepted, and they bypass the\nprivate address check (so internal hosts can be listed)",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "clientMetadataTimeout": {
            "default": 5,
            "type": "number"
          },
          "clients": {
            "$ref": "#/definitions/Record%3Cstring%2C%20Omit%3COAuthClient%2C%20%22id%22%3E%20%7C%20null%3E",
            "description": "Static clients by id; `null` removes a built-in client"
          },
          "codeTtl": {
            "default": 60,
            "type": "number"
          },
          "consentUrl": {
            "description": "Consent UI; defaults to the built-in page",
            "type": "string"
          },
          "deviceCodeTtl": {
            "default": 600,
            "type": "number"
          },
          "devicePollInterval": {
            "default": 5,
            "type": "number"
          },
          "deviceUrl": {
            "description": "Device code entry UI; defaults to the built-in page",
            "type": "string"
          },
          "issuer": {
            "description": "Issuer; defaults to the request origin",
            "type": "string"
          },
          "loginUrl": {
            "description": "Application login page, receives `?redirect=`",
            "type": "string"
          },
          "refreshTtl": {
            "description": "Refresh token lifetime (s); defaults to TokenService",
            "type": "number"
          },
          "rememberConsent": {
            "default": true,
            "type": "boolean"
          },
          "rememberConsentTtl": {
            "default": 7776000,
            "type": "number"
          },
          "resultUrl": {
            "description": "Result UI; defaults to the built-in page",
            "type": "string"
          },
          "scopesSupported": {
            "description": "Advertised scopes; defaults to the top-level operation groups",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "url": {
            "default": "/oauth",
            "type": "string"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "clientMetadataHosts",
          "clients",
          "loginUrl",
          "type"
        ],
        "type": "object",
        "title": "OAuthServer"
      },
      "Configuration": "lib/parameters:OAuthServerParameters"
    }
  },
