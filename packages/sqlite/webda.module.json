{
  "$schema": "https://webda.io/schemas/webda.module.v4.json",
  "beans": {},
  "deployers": {},
  "moddas": {
    "Webda/SQLitePubSub": {
      "Import": "lib/sqlitepubsub.service:default",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "Record<string, string | number>": {
            "additionalProperties": {
              "type": [
                "string",
                "number"
              ]
            },
            "description": "Construct a type with a set of properties K of type T",
            "type": "object"
          },
          "SQLDatabase": {
            "additionalProperties": false,
            "description": "Database connection metadata",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "SQLitePersistence": {
            "additionalProperties": false,
            "description": "Same name and role as MemoryStoreParameters.persistence",
            "properties": {
              "path": {
                "description": "Database file; relative paths resolve against the application directory",
                "type": "string"
              },
              "readOnly": {
                "default": false,
                "description": "Open the file read-only: writes are rejected with a WebdaError",
                "type": "boolean"
              },
              "synchronous": {
                "default": "\"NORMAL\" with WAL, \"FULL\" otherwise",
                "description": "PRAGMA synchronous",
                "enum": [
                  "OFF",
                  "NORMAL",
                  "FULL",
                  "EXTRA"
                ],
                "type": "string"
              },
              "wal": {
                "default": true,
                "description": "PRAGMA journal_mode=WAL (concurrent readers across processes)",
                "type": "boolean"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          }
        },
        "description": "Configuration for {@link SQLitePubSubService}",
        "properties": {
          "autoCreateTable": {
            "default": true,
            "description": "Create the table on init",
            "type": "boolean"
          },
          "batchSize": {
            "default": 100,
            "description": "Max messages fetched per poll",
            "type": "number"
          },
          "busyTimeout": {
            "default": 5000,
            "description": "PRAGMA busy_timeout in ms",
            "type": "number"
          },
          "channel": {
            "default": "the service name lowercased",
            "description": "Channel name",
            "type": "string"
          },
          "database": {
            "$ref": "#/definitions/SQLDatabase",
            "description": "Services giving the same database name share one handle"
          },
          "persistence": {
            "$ref": "#/definitions/SQLitePersistence",
            "description": "Omitted: in-process only (services sharing `database.name`); set: file shared by the processes of one host"
          },
          "pollInterval": {
            "default": 100,
            "description": "Poll interval in ms for messages written by other processes",
            "type": "number"
          },
          "pragmas": {
            "$ref": "#/definitions/Record%3Cstring%2C%20string%20%7C%20number%3E",
            "description": "Extra PRAGMAs run on open"
          },
          "retention": {
            "default": 60,
            "description": "Seconds a message is kept for slow consumers before being purged",
            "type": "number"
          },
          "table": {
            "default": "webda_pubsub",
            "description": "Table holding the message log",
            "pattern": "/^[a-zA-Z_][a-zA-Z0-9_]*$/",
            "type": "string"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "type"
        ],
        "type": "object",
        "title": "SQLitePubSubService"
      },
      "Configuration": "lib/sqlitepubsub.service:SQLitePubSubParameters"
    },
    "Webda/SQLiteQueue": {
      "Import": "lib/sqlitequeue.service:default",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "Record<string, string | number>": {
            "additionalProperties": {
              "type": [
                "string",
                "number"
              ]
            },
            "description": "Construct a type with a set of properties K of type T",
            "type": "object"
          },
          "SQLDatabase": {
            "additionalProperties": false,
            "description": "Database connection metadata",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "SQLitePersistence": {
            "additionalProperties": false,
            "description": "Same name and role as MemoryStoreParameters.persistence",
            "properties": {
              "path": {
                "description": "Database file; relative paths resolve against the application directory",
                "type": "string"
              },
              "readOnly": {
                "default": false,
                "description": "Open the file read-only: writes are rejected with a WebdaError",
                "type": "boolean"
              },
              "synchronous": {
                "default": "\"NORMAL\" with WAL, \"FULL\" otherwise",
                "description": "PRAGMA synchronous",
                "enum": [
                  "OFF",
                  "NORMAL",
                  "FULL",
                  "EXTRA"
                ],
                "type": "string"
              },
              "wal": {
                "default": true,
                "description": "PRAGMA journal_mode=WAL (concurrent readers across processes)",
                "type": "boolean"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "WaitDelayerDefinition": {
            "additionalProperties": false,
            "description": "Configuration object for selecting and parameterizing a `WaitDelayer` from the registry.",
            "properties": {
              "interval": {
                "description": "Base interval in milliseconds passed to the delayer factory.",
                "type": "number"
              },
              "type": {
                "description": "Key identifying the factory in `WaitDelayerFactories.registry` (e.g. `\"linear\"`, `\"exponential\"`).",
                "type": "string"
              }
            },
            "required": [
              "interval",
              "type"
            ],
            "type": "object"
          }
        },
        "description": "Configuration for {@link SQLiteQueueService}",
        "properties": {
          "autoCreateTable": {
            "default": true,
            "description": "Create the queue table on init",
            "type": "boolean"
          },
          "batchSize": {
            "default": 10,
            "description": "Messages per receiveMessage",
            "type": "number"
          },
          "busyTimeout": {
            "default": 5000,
            "description": "PRAGMA busy_timeout in ms",
            "type": "number"
          },
          "database": {
            "$ref": "#/definitions/SQLDatabase",
            "description": "Services giving the same database name share one handle"
          },
          "maxConsumers": {
            "default": 10,
            "description": "Max number of queue consumers\nQueue will auto increase to this max number if queue is loaded\nand it will decrease to just one consumer if no messages are available",
            "type": "number"
          },
          "persistence": {
            "$ref": "#/definitions/SQLitePersistence",
            "description": "Omitted: in-memory queue, lost on stop(); set: file database, messages survive restarts"
          },
          "pragmas": {
            "$ref": "#/definitions/Record%3Cstring%2C%20string%20%7C%20number%3E",
            "description": "Extra PRAGMAs run on open"
          },
          "table": {
            "default": "webda_queue",
            "description": "Table backing the queue, created on init",
            "pattern": "/^[a-zA-Z_][a-zA-Z0-9_]*$/",
            "type": "string"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "visibilityTimeout": {
            "default": 30,
            "description": "Seconds a received but not deleted message stays invisible before being delivered again",
            "type": "number"
          },
          "waitTime": {
            "default": 1,
            "description": "Seconds an empty receiveMessage waits for a message before returning (long polling): a message sent by this\nprocess ends the wait at once, one written by another process is seen at the end of it",
            "type": "number"
          },
          "workerDelayer": {
            "$ref": "#/definitions/WaitDelayerDefinition",
            "description": "Delayer between two failed attempts to process messages"
          },
          "workerParallelism": {
            "default": true,
            "description": "Define if worker should process multi message received in //",
            "type": "boolean"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "type"
        ],
        "type": "object",
        "title": "SQLiteQueueService"
      },
      "Configuration": "lib/sqlitequeue.service:SQLiteQueueParameters"
    },
    "Webda/SQLiteStore": {
      "Import": "lib/sqlitestore.service:SQLiteStore",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "Record<string, string | number>": {
            "additionalProperties": {
              "type": [
                "string",
                "number"
              ]
            },
            "description": "Construct a type with a set of properties K of type T",
            "type": "object"
          },
          "SQLDatabase": {
            "additionalProperties": false,
            "description": "Database connection metadata",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "SQLitePersistence": {
            "additionalProperties": false,
            "description": "Same name and role as MemoryStoreParameters.persistence",
            "properties": {
              "path": {
                "description": "Database file; relative paths resolve against the application directory",
                "type": "string"
              },
              "readOnly": {
                "default": false,
                "description": "Open the file read-only: writes are rejected with a WebdaError",
                "type": "boolean"
              },
              "synchronous": {
                "default": "\"NORMAL\" with WAL, \"FULL\" otherwise",
                "description": "PRAGMA synchronous",
                "enum": [
                  "OFF",
                  "NORMAL",
                  "FULL",
                  "EXTRA"
                ],
                "type": "string"
              },
              "wal": {
                "default": true,
                "description": "PRAGMA journal_mode=WAL (concurrent readers across processes)",
                "type": "boolean"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "tables#2": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Per-model table name overrides.\nMaps a model identifier (e.g. \"Webda/User\") to a custom table name.",
            "type": "object"
          },
          "typeCheck#2": {
            "additionalProperties": false,
            "description": "Startup check of the stored types: one WARN listing the legacy, untyped and unknown types found",
            "properties": {
              "enabled": {
                "default": true,
                "type": "boolean"
              },
              "maxRows": {
                "default": 10000,
                "description": "Rows scanned at most by stores without a native count; beyond, the counts are \"at least\"",
                "type": "number"
              }
            },
            "type": "object"
          }
        },
        "description": "Parameters of SQLiteStore: the SQLStore tables plus the shared SQLite connection parameters",
        "properties": {
          "aggregationFallback": {
            "default": "warn",
            "description": "What to do when an aggregation on this store cannot run natively and must\nstream every matching object through memory",
            "enum": [
              "allow",
              "warn",
              "deny"
            ],
            "type": "string"
          },
          "autoCreateTable": {
            "default": true,
            "description": "Auto create tables if they do not exist",
            "type": "boolean"
          },
          "busyTimeout": {
            "default": 5000,
            "description": "PRAGMA busy_timeout in ms",
            "type": "number"
          },
          "database": {
            "$ref": "#/definitions/SQLDatabase"
          },
          "maxGroups": {
            "default": 10000,
            "description": "Maximum number of groups an aggregation may produce without LIMIT (or in memory)",
            "minimum": 1,
            "type": "number"
          },
          "models": {
            "default": [
              "Webda/RegistryEntry"
            ],
            "description": "Models managed by this Store.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "noCache": {
            "default": false,
            "description": "Disable default memory cache",
            "type": "boolean"
          },
          "persistence": {
            "$ref": "#/definitions/SQLitePersistence",
            "description": "Omitted: in-memory database, lost on stop() (like MemoryStore without persistence)\nSet: file database, every committed write is durable"
          },
          "pragmas": {
            "$ref": "#/definitions/Record%3Cstring%2C%20string%20%7C%20number%3E",
            "description": "Extra PRAGMAs run on open, e.g. { cache_size: -64000 }"
          },
          "slowQueryThreshold": {
            "default": 30000,
            "description": "Slow query threshold",
            "type": "number"
          },
          "strict": {
            "default": false,
            "description": "Allow to load object that does not have the type data\n\nIf set to true, then the Store will only managed the defined _model and no\nmodel extending this one",
            "type": "boolean"
          },
          "table": {
            "description": "The table of every model of the store, subclasses and models routed to this store as fallback included (the\nWebda 3 layout). Without it each model gets its own table (its identifier lowercased with \"/\" → \"_\").",
            "type": "string"
          },
          "tables": {
            "$ref": "#/definitions/tables%232",
            "description": "Per-model table name overrides.\nMaps a model identifier (e.g. \"Webda/User\") to a custom table name."
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "typeCheck": {
            "$ref": "#/definitions/typeCheck%232",
            "description": "Startup check of the stored types: one WARN listing the legacy, untyped and unknown types found"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "table",
          "type"
        ],
        "type": "object",
        "title": "SQLiteStore"
      },
      "Configuration": "lib/sqlitestore.service:SQLiteStoreParameters",
      "capabilities": [
        "store"
      ],
      "commands": {
        "migrate": {
          "description": "Rewrite the Webda 3 types of the stores to their Webda 4 identifiers",
          "method": "migrate",
          "args": {
            "dryRun": {
              "type": "boolean",
              "default": false,
              "description": "Only count the rows to migrate, write nothing"
            },
            "batch": {
              "type": "number",
              "default": 500,
              "description": "Rows per page"
            },
            "allowUnknown": {
              "type": "boolean",
              "default": false,
              "description": "Exit with 0 even when rows keep an unknown or ambiguous type"
            }
          },
          "phase": "initialized"
        }
      }
    }
  },
  "models": {},
  "schemas": {
    "Webda/BinaryFile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "WebdaSchema": true,
      "additionalProperties": false,
      "description": "Represent a file to store",
      "properties": {
        "hash": {
          "description": "Will be computed by the service\n\nhash of the content",
          "type": "string"
        },
        "metadata": {
          "description": "Metadatas stored along with the binary"
        },
        "mimetype": {
          "description": "Mimetype of the binary",
          "type": "string"
        },
        "name": {
          "description": "Current name",
          "type": "string"
        },
        "originalname": {
          "description": "Original name",
          "type": "string"
        },
        "size": {
          "description": "Size of the binary",
          "type": "number"
        }
      },
      "required": [
        "mimetype",
        "name",
        "size"
      ],
      "type": "object",
      "title": "BinaryFile"
    }
  },
  "behaviors": {}
}