          },
          "serverVersion": {
            "description": "Server version announced to clients (defaults to the application package version)",
            "type": "string"
          },
          "sessionTimeout": {
            "default": 1800,
            "description": "Seconds of inactivity before an MCP session is evicted",
            "type": "number"
          },
