{
  "name": "@webda/sqlite",
  "version": "4.0.0-beta.4",
  "description": "SQLite store, queue and pub/sub for webda on node:sqlite (in memory or file)",
  "keywords": [
    "sqlite",
    "webda"
  ],
  "author": "Remi Cattiau <remi@cattiau.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/sqlite"
  },
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "webdac build",
    "build:watch": "webdac build --watch",
    "pretest": "npm run build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "bench": "vitest run --config vitest.bench.config.ts",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "deps:graph": "skott --showCircularDependencies --no-trackTypeOnlyDependencies --displayMode=raw -e .ts"
  },
  "dependencies": {
    "@webda/core": "workspace:*",
    "@webda/ql": "workspace:*",
    "@webda/sql": "workspace:*",
    "@webda/utils": "workspace:*",
    "@webda/workout": "workspace:*"
  },
  "files": [
    "lib",
    "test",
    "webda.module.json"
  ],
  "homepage": "https://webda.io",
  "publishConfig": {
    "access": "public"
  },
  "webda": {
    "namespace": "Webda"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@webda/bench": "workspace:*",
    "@webda/compiler": "workspace:^",
    "@webda/test": "workspace:*",
    "skott": "^0.35.8",
    "tsx": "^4.21.0",
    "typescript": "7.1.0-dev.20260929.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "nx": {
    "implicitDependencies": [
      "@webda/core"
    ]
  },
  "license": "LGPL-3.0-only"
}
