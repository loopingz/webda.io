{
  "name": "@webda/react-email",
  "version": "4.0.0-beta.11",
  "description": "React Email components as Webda templates",
  "keywords": [
    "react-email",
    "templates",
    "webda"
  ],
  "author": "Remi Cattiau <remi@cattiau.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/react-email"
  },
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "webdac build",
    "build:watch": "webdac build --watch",
    "pretest": "npm run build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "deps:graph": "skott --showCircularDependencies --no-trackTypeOnlyDependencies --displayMode=raw -e .ts",
    "codemod": "jscodeshift --parser=ts --extensions=tsx,ts -t ../codemod/current.mjs src"
  },
  "dependencies": {
    "@webda/core": "workspace:*",
    "@webda/templates": "workspace:*"
  },
  "files": [
    "lib",
    "test",
    "webda.module.json"
  ],
  "homepage": "https://webda.io",
  "publishConfig": {
    "access": "public"
  },
  "webda": {
    "namespace": "Webda"
  },
  "devDependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@webda/compiler": "workspace:^",
    "@webda/test": "workspace:*",
    "@webda/workout": "workspace:*",
    "jscodeshift": "^17.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "skott": "^0.35.12",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-dev.20261102.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "nx": {
    "implicitDependencies": [
      "@webda/core",
      "@webda/templates"
    ]
  },
  "license": "LGPL-3.0-only",
  "peerDependencies": {
    "@react-email/render": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0"
  },
  "peerDependenciesMeta": {
    "tsx": {
      "optional": true
    }
  }
}
