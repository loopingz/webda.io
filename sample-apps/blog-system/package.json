{
  "name": "@webda/sample-blog-system",
  "version": "3.999.0",
  "description": "Complete blog system demonstrating all @webda/models features in a real-world application",
  "keywords": [
    "webda",
    "models",
    "blog",
    "complete-example"
  ],
  "author": "Webda Team",
  "repository": "git://github.com/loopingz/webda.io.git",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "webdac build",
    "debug": "webda debug",
    "debug:web": "webda debug --web",
    "webda": "webda",
    "test": "vitest run",
    "bench": "vitest run --config vitest.bench.config.ts",
    "test:api": "vitest run test/api-test.ts",
    "test:cli": "vitest run test/cli-test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "PW_SLOWMO=500 playwright test --headed",
    "deps:graph": "skott --showCircularDependencies --no-trackTypeOnlyDependencies --displayMode=raw -e .ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@webda/core": "workspace:*",
    "@webda/fs": "workspace:^",
    "@webda/graphql": "workspace:^",
    "@webda/grpc": "workspace:^",
    "@webda/mailer": "workspace:^",
    "@webda/mcp": "workspace:^",
    "@webda/models": "workspace:^",
    "@webda/ql": "workspace:^",
    "@webda/utils": "workspace:^",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.6",
    "@webda/bench": "workspace:*",
    "@webda/compiler": "workspace:^",
    "@webda/debug": "workspace:^",
    "@webda/mongo": "workspace:^",
    "@webda/postgres": "workspace:^",
    "@webda/test": "workspace:*",
    "skott": "^0.35.12",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-dev.20261102.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "license": "LGPL-3.0-only",
  "webda": {
    "namespace": "WebdaSample"
  }
}
