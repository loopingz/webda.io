    "Webda/GoogleCloudFireStore": {
      "Import": "lib/services/firestore.service:default",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "FireStoreIndex": {
            "additionalProperties": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            },
            "description": "Definition of a FireStore index",
            "type": "object"
          },
          "collections": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Per-model collection overrides.\nMaps a model identifier (e.g. \"Webda/User\") to a collection name.\nWhen not specified, the first model uses `collection` and others use their identifier\nlowercased with \"/\" replaced by \"_\".",
            "type": "object"
          },
          "modelAliases": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Model Aliases to allow easier rename of Model",
            "type": "object"
          }
        },
        "description": "Firebase parameters",
        "properties": {
          "collection": {
            "description": "Collection to use",
            "type": "string"
          },
          "collections": {
            "$ref": "#/definitions/collections",
            "description": "Per-model collection overrides.\nMaps a model identifier (e.g. \"Webda/User\") to a collection name.\nWhen not specified, the first model uses `collection` and others use their identifier\nlowercased with \"/\" replaced by \"_\"."
          },
          "compoundIndexes": {
            "description": "To allow efficient query on several fields",
            "items": {
              "$ref": "#/definitions/FireStoreIndex"
            },
            "see": "https://firebase.google.com/docs/firestore/query-data/queries",
            "type": "array"
          },
          "defaultModel": {
            "default": true,
            "description": "When __type model not found, use the model\nIf strict is setup this parameter is not used",
            "type": "boolean"
          },
          "forceModel": {
            "default": false,
            "description": "If set, Store will ignore the __type",
            "type": "boolean"
          },
          "modelAliases": {
            "$ref": "#/definitions/modelAliases",
            "description": "Model Aliases to allow easier rename of Model"
          },
          "models": {
            "default": [
              "Webda/RegistryEntry"
            ],
            "description": "Models managed by this Store.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "noCache": {
            "default": false,
            "description": "Disable default memory cache",
            "type": "boolean"
          },
          "slowQueryThreshold": {
            "default": 30000,
            "description": "Slow query threshold",
            "type": "number"
          },
          "strict": {
            "default": false,
            "description": "Allow to load object that does not have the type data\n\nIf set to true, then the Store will only managed the defined _model and no\nmodel extending this one",
            "type": "boolean"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "collection",
          "type"
        ],
        "type": "object",
        "title": "FireStore"
      },
      "Configuration": "lib/services/firestore.service:FireStoreParameters"
    },
