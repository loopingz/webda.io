{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2019", "DOM"],
    "module": "nodenext",
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": false,
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": false,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "declarationMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["**/node_modules", "lib/**/*"],
  "ts-node": {
    "transpileOnly": true,
    "preferTsExts": true,
    "compilerOptions": {
      "experimentalDecorators": false
    },
    "include": ["src/**/*.spec.ts"],
    "exclude": ["src/models/**/*"]
  }
}
