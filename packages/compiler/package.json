{
  "name": "@webda/compiler",
  "version": "4.0.0-beta.13",
  "description": "Expose API with Lambda",
  "keywords": [
    "aws",
    "lamda",
    "api gateway"
  ],
  "author": "Remi Cattiau <remi@cattiau.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/compiler"
  },
  "main": "lib/index.js",
  "bin": {
    "webdac": "./lib/shell.js"
  },
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "deps:graph": "skott --showCircularDependencies --no-trackTypeOnlyDependencies --displayMode=raw -e .ts",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "schema": "ts-json-schema-generator --path src/definition.ts -f ./tsconfig.json --type 'WebdaModule' -o ./webda.module.schema.json",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@types/json-schema": "^7.0.15",
    "@webda/content-mapper": "workspace:*",
    "@webda/utils": "workspace:^",
    "@webda/workout": "workspace:*",
    "accept-language": "^3.0.20",
    "diff": "^9.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "7.1.0-dev.20261102.1",
    "yargs": "^18.2.0",
    "yoctocolors": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/yargs": "^17.0.35",
    "@webda/test": "workspace:*",
    "eslint": "^10.14.0",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.10",
    "skott": "^0.35.12",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "files": [
    "lib",
    "webda.module.json"
  ],
  "homepage": "https://webda.io",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "LGPL-3.0-only"
}
