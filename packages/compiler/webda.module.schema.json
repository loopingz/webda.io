{
  "$ref": "#/definitions/WebdaModule",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "BehaviorMetadata": {
      "additionalProperties": false,
      "description": "Compile-time metadata for a class marked with `@Behavior()`.",
      "properties": {
        "Actions": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "global": {
                "description": "If true, the action is global (static method) rather than per-instance",
                "type": "boolean"
              },
              "handler": {
                "description": "Method implementing the action, when exposed under another name with `@Action({ name })`",
                "type": "string"
              },
              "maxMfaAge": {
                "description": "Require the second factor to be verified within this duration (Duration syntax), see `OperationDefinition.maxMfaAge`",
                "type": [
                  "number",
                  "string"
                ]
              },
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "rest": {
                "additionalProperties": false,
                "description": "Behavior-only: per-action REST hint that overrides the default `{prefix}/{uuid}/{attribute}.{actionName}` PUT mapping.\n\n- `route === \".\"` → URL is the bare attribute path   `{prefix}/{uuid}/{attribute}`.\n- `route === \"<suffix>\"` → URL is   `{prefix}/{uuid}/{attribute}/<suffix>`. Path templates such as   `\"{hash}\"` or `\"{index}/{hash}\"` are passed through unchanged so   the router treats them as path variables.\n- `route === undefined` → URL falls back to the dot-notation default.\n\n`method` defaults to `\"PUT\"`.",
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "route": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "summary": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "description": "Behavior actions discovered from `@Action` / `@Operation` methods. Same shape as `ModelMetadata.Actions`.",
          "type": "object"
        },
        "Configuration": {
          "description": "Export of the behavior's Parameters class.",
          "type": "string"
        },
        "Identifier": {
          "description": "Identifier of the Behavior (e.g. \"Webda/MFA\").",
          "type": "string"
        },
        "Import": {
          "description": "Module-relative path used at runtime to import the class.",
          "type": "string"
        },
        "Schema": {
          "$ref": "#/definitions/JSONSchema7",
          "description": "Typed runtime parameter schema."
        }
      },
      "required": [
        "Identifier",
        "Import",
        "Actions"
      ],
      "type": "object"
    },
    "CommandArgDefinition": {
      "additionalProperties": false,
      "description": "Definition of a single CLI argument for a  {@link  CommandDefinition } .\n\nGenerated by the compiler from method parameter analysis:\n- `type` from TypeScript type annotation\n- `default` from parameter initializer\n- `required` when no default and no `?` modifier\n- `alias`, `description`, `deprecated` from JSDoc tags on the parameter",
      "properties": {
        "alias": {
          "description": "Single-character alias for the flag (e.g., `\"p\"` for `--port`). Extracted from the `@alias` JSDoc tag on the parameter.",
          "type": "string"
        },
        "default": {
          "description": "Default value from the method parameter initializer. Omitted if the parameter has no default."
        },
        "deprecated": {
          "description": "Deprecation message. When present, the CLI warns users that this flag is deprecated. Extracted from the `@deprecated` JSDoc tag.",
          "type": "string"
        },
        "description": {
          "description": "Help text displayed in `--help` output for this argument. Extracted from the `@description` JSDoc tag on the parameter.",
          "type": "string"
        },
        "required": {
          "description": "`true` if the parameter has no default value and no `?` modifier, meaning the user must provide this argument. Omitted when `false`.",
          "type": "boolean"
        },
        "type": {
          "description": "The argument type, determining how the CLI parses the value. Mapped from the TypeScript type annotation on the method parameter.",
          "enum": [
            "string",
            "number",
            "boolean"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "CommandDefinition": {
      "additionalProperties": false,
      "description": "Definition of a CLI command declared via the `@Command` decorator on a service method.\n\nWritten into `webda.module.json` under `moddas[serviceName].commands` or `beans[serviceName].commands` by the  {@link  CommandsMetadata  }  compiler plugin.",
      "properties": {
        "args": {
          "additionalProperties": {
            "$ref": "#/definitions/CommandArgDefinition"
          },
          "description": "Map of argument name to its definition. Keys are method parameter names, which become `--flag` names in the CLI.",
          "type": "object"
        },
        "description": {
          "description": "Human-readable description of the command, displayed in CLI help output. Extracted from the `description` option in `@Command(\"name\", { description: \"...\" })`.",
          "type": "string"
        },
        "method": {
          "description": "Name of the method on the service class that handles this command. The shell calls `service[method](...args)` when the command is invoked.",
          "type": "string"
        },
        "phase": {
          "description": "Lifecycle phase at which this command runs.\n- `\"initialized\"` (default when omitted): after `Core.init()`.\n- `\"resolved\"`: after `Core.resolve()` only. No service.init() called.   Used for build-time hooks (e.g. `@BuildCommand`).\n- `\"application\"`: with the loaded application only, no Core. The method is static.",
          "enum": [
            "application",
            "resolved",
            "initialized"
          ],
          "type": "string"
        },
        "requires": {
          "description": "Capabilities required by this command. The CLI resolves these against the capabilities map and auto-injects missing services before booting Core.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "description",
        "method",
        "args"
      ],
      "type": "object"
    },
