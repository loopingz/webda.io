{
  "version": 3,
  "parameters": {
    "ignoreBeans": true
  },
  "services": {
    "CryptoService": {
      "type": "Webda/CryptoService",
      "autoCreate": true,
      "url": "/jwks"
    },
    "OIDCIssuer": {
      "type": "Webda/OIDCIssuer",
