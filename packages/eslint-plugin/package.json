{
  "name": "@webda/eslint-plugin",
  "version": "4.0.0-rc.1",
  "description": "ESLint plugin enforcing Webda.io best practices",
  "keywords": [
    "webda",
    "eslint",
    "eslint-plugin",
    "linter"
  ],
  "author": "Remi Cattiau <remi@cattiau.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/eslint-plugin"
  },
  "main": "lib/index.js",
  "exports": {
    "default": "./lib/index.js"
  },
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "deps:graph": "skott --showCircularDependencies --no-trackTypeOnlyDependencies --displayMode=raw -e .ts",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "pretest": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "skott": "^0.35.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "files": [
    "lib"
  ],
  "homepage": "https://webda.io",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "LGPL-3.0-only"
}
