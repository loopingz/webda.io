{
  "name": "@webda/google-auth",
  "version": "4.0.0-beta.14",
  "description": "Webda Google Authentication",
  "main": "lib/index.js",
  "scripts": {
    "build": "webdac build",
    "build:watch": "webdac build --watch",
    "pretest": "npm run build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "deps:graph": "skott --showCircularDependencies --no-trackTypeOnlyDependencies --displayMode=raw -e .ts",
    "codemod": "jscodeshift --parser=ts --extensions=tsx,ts -t ../codemod/current.mjs src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/google-auth"
  },
  "keywords": [
    "webda",
    "modda"
  ],
  "files": [
    "lib",
    "webda.module.json",
    "package.json"
  ],
  "author": "loopingz",
  "license": "LGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/loopingz/webda.io/issues"
  },
  "homepage": "https://github.com/loopingz/webda.io#readme",
  "dependencies": {
    "@webda/auth": "workspace:*",
    "@webda/core": "workspace:*",
    "google-auth-library": "^11.3.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@webda/compiler": "workspace:^",
    "@webda/content-mapper": "workspace:^",
    "@webda/test": "workspace:*",
    "@webda/workout": "workspace:*",
    "jscodeshift": "^17.4.0",
    "skott": "^0.35.12",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-dev.20261102.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "nx": {
    "implicitDependencies": [
      "@webda/core",
      "@webda/auth"
    ]
  }
}
