{
  "name": "webda.io",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@types/json-schema": "^7.0.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "commitlint": "^21.2.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "gh-pages": "^6.3.0",
    "glob": "^14.0.3",
    "husky": "^9.1.7",
    "jsonpath": "^1.3.0",
    "lint-staged": "^17.6.0",
    "merge-stream": "^2.0.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sinon": "^22.1.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "author": "loopingz",
  "license": "LGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/loopingz/webda.io/issues"
  },
  "homepage": "https://github.com/loopingz/webda.io#readme",
  "repository": "git://github.com/loopingz/webda.io.git",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --filter='!@webda/docs' run build",
    "test": "pnpm -r run test",
    "test:mocha": "pnpm -r run test:mocha",
    "test:jest": "pnpm -r run test:jest",
    "test:bun": "pnpm -r run test:bun",
    "bench": "pnpm -r --workspace-concurrency=1 --no-bail --if-present run bench",
    "bench:report": "node packages/bench/lib/bin/webda-bench.js report packages/*/bench-results sample-apps/*/bench-results",
    "new-version": "pnpm run build && pnpm -r exec pnpm version --no-git-tag-version",
    "new-module": "pnpm webda init webda:module",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "publish:all": "pnpm -r publish",
    "docs": "cd docs && pnpm run update:typedoc && pnpm run build && echo 'webda.io' > build/CNAME",
    "docs:publish": "pnpm run docs && gh-pages -t -d docs/build",
    "deps:graph": "pnpm -r run deps:graph",
    "init": "husky",
    "release-as": "./scripts/release-as.sh",
    "format": "prettier --check \"{packages,sample-app,sample-apps}/**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"{packages,sample-app,sample-apps}/**/*.{ts,tsx}\""
  },
  "pnpm": {
    "overrides": {
      "whatwg-url": "^14.0.0",
      "webpackbar": "^7.0.0",
      "nodemailer@<10.0.6": "^10.0.16"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "protobufjs",
      "unrs-resolver"
    ]
  },
  "webda": {
    "randomLink": "./test.json",
    "namespace": "Webda"
  },
  "type": "module",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ]
  }
}
