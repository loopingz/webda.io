  "schemas": {
    "Webda/BinaryFile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "WebdaSchema": true,
      "additionalProperties": false,
      "description": "Represent a file to store",
      "properties": {
        "hash": {
          "description": "Will be computed by the service\n\nhash of the content",
          "type": "string"
        },
        "metadata": {
          "description": "Metadatas stored along with the binary"
        },
        "mimetype": {
          "description": "Mimetype of the binary",
          "type": "string"
        },
        "name": {
          "description": "Current name",
          "type": "string"
        },
        "originalname": {
          "description": "Original name",
          "type": "string"
        },
        "size": {
          "description": "Size of the binary",
          "type": "number"
        }
      },
      "required": [
        "mimetype",
        "name",
        "size"
      ],
      "type": "object",
      "title": "BinaryFile"
    },
    "SyncService.pull.input": {
      "type": "object",
      "properties": {
        "scopes": {
          "items": {
            "$ref": "#/definitions/SyncScope"
          },
          "type": "array"
        },
        "cursor": {
          "type": "string"
        },
        "limit": {
          "type": "number"
        }
      },
      "required": [
        "scopes"
      ],
      "definitions": {
        "SyncScope": {
          "additionalProperties": false,
          "description": "A sync scope: the objects of `model` matching the WebdaQL filter `query` (all of them when omitted)",
          "properties": {
            "model": {
              "type": "string"
            },
            "query": {
              "type": "string"
            }
          },
          "required": [
            "model"
          ],
          "type": "object"
        }
      }
    },
    "SyncService.pull.output": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "string"
        },
        "evicts": {
          "items": {
            "$ref": "#/definitions/SyncRef"
          },
          "type": "array"
        },
        "hasMore": {
          "default": false,
          "type": "boolean"
        },
        "resync": {
          "default": false,
          "description": "The cursor is missing or older than the retention: snapshot every scope, then pull from `cursor`",
          "type": "boolean"
        },
        "upserts": {
          "items": {
            "$ref": "#/definitions/SyncedObject"
          },
          "type": "array"
        }
      },
      "required": [
        "cursor",
        "evicts",
        "upserts"
      ],
      "type": "object",
      "definitions": {
        "SyncRef": {
          "additionalProperties": false,
          "description": "Reference to one object: model identifier and canonical key (see {@link serializeKey})",
          "properties": {
            "key": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          },
          "required": [
            "key",
            "model"
          ],
          "type": "object"
        },
        "SyncedObject": {
          "additionalProperties": false,
          "description": "An object as sent by the server",
          "properties": {
            "object": {},
            "ref": {
              "$ref": "#/definitions/SyncRef"
            },
            "rev": {
              "type": "number"
            }
          },
          "required": [
            "object",
            "ref",
            "rev"
          ],
          "type": "object"
        }
      }
    },
    "SyncService.snapshot.input": {
      "type": "object",
      "properties": {
        "scope": {
          "additionalProperties": false,
          "description": "A sync scope: the objects of `model` matching the WebdaQL filter `query` (all of them when omitted)",
          "properties": {
            "model": {
              "type": "string"
            },
            "query": {
              "type": "string"
            }
          },
          "required": [
            "model"
          ],
          "type": "object"
        },
        "continuationToken": {
          "type": "string"
        }
      },
      "required": [
        "scope"
      ]
    },
    "SyncService.snapshot.output": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "continuationToken": {
          "type": "string"
        },
        "objects": {
          "items": {
            "$ref": "#/definitions/SyncedObject"
          },
          "type": "array"
        }
      },
      "required": [
        "objects"
      ],
      "type": "object",
      "definitions": {
        "SyncRef": {
          "additionalProperties": false,
          "description": "Reference to one object: model identifier and canonical key (see {@link serializeKey})",
          "properties": {
            "key": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          },
          "required": [
            "key",
            "model"
          ],
          "type": "object"
        },
        "SyncedObject": {
          "additionalProperties": false,
          "description": "An object as sent by the server",
          "properties": {
            "object": {},
            "ref": {
              "$ref": "#/definitions/SyncRef"
            },
            "rev": {
              "type": "number"
            }
          },
          "required": [
            "object",
            "ref",
            "rev"
          ],
          "type": "object"
        }
      }
    },
    "SyncService.push.input": {
      "type": "object",
      "properties": {
        "mutations": {
          "items": {
            "$ref": "#/definitions/Mutation"
          },
          "type": "array"
        }
      },
      "required": [
        "mutations"
      ],
      "definitions": {
        "Mutation": {
          "additionalProperties": false,
          "properties": {
            "baseRev": {
              "description": "Revision the change was made on, 0 for a create",
              "type": "number"
            },
            "mutationId": {
              "description": "Client-generated id, kept across retries so a replayed mutation is answered `ok`",
              "type": "string"
            },
            "op": {
              "enum": [
                "create",
                "patch",
                "delete"
              ],
              "type": "string"
            },
            "patch": {
              "description": "The full object for \"create\", a `@webda/versioning` Delta for \"patch\""
            },
            "ref": {
              "$ref": "#/definitions/SyncRef"
            }
          },
          "required": [
            "baseRev",
            "mutationId",
            "op",
            "ref"
          ],
          "type": "object"
        },
        "SyncRef": {
          "additionalProperties": false,
          "description": "Reference to one object: model identifier and canonical key (see {@link serializeKey})",
          "properties": {
            "key": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          },
          "required": [
            "key",
            "model"
          ],
          "type": "object"
        }
      }
    },
    "SyncService.push.output": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "results": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/definitions/results%5B%5D%231"
              },
              {
                "$ref": "#/definitions/results%5B%5D%232"
              },
              {
                "$ref": "#/definitions/results%5B%5D%233"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "results"
      ],
      "type": "object",
      "definitions": {
        "results[]#1": {
          "additionalProperties": false,
          "properties": {
            "mutationId": {
              "type": "string"
            },
            "object": {},
            "rev": {
              "type": "number"
            },
            "status": {
              "const": "ok",
              "type": "string"
            }
          },
          "required": [
            "mutationId",
            "rev",
            "status"
          ],
          "type": "object"
        },
        "results[]#2": {
          "additionalProperties": false,
          "properties": {
            "mutationId": {
              "type": "string"
            },
            "object": {},
            "rev": {
              "type": "number"
            },
            "status": {
              "const": "conflict",
              "type": "string"
            }
          },
          "required": [
            "mutationId",
            "object",
            "rev",
            "status"
          ],
          "type": "object"
        },
        "results[]#3": {
          "additionalProperties": false,
          "properties": {
            "error": {
              "$ref": "#/definitions/results%5B%5D%233%24error"
            },
            "mutationId": {
              "type": "string"
            },
            "status": {
              "const": "rejected",
              "type": "string"
            }
          },
          "required": [
            "error",
            "mutationId",
            "status"
          ],
          "type": "object"
        },
        "results[]#3$error": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "type": "object"
        }
      }
    },
    "SyncService.watch.input": {
      "type": "object",
      "properties": {
        "scopes": {
          "items": {
            "$ref": "#/definitions/SyncScope"
          },
          "type": "array"
        },
        "_cursor": {
          "type": "string"
        }
      },
      "required": [
        "scopes"
      ],
      "definitions": {
        "SyncScope": {
          "additionalProperties": false,
          "description": "A sync scope: the objects of `model` matching the WebdaQL filter `query` (all of them when omitted)",
          "properties": {
            "model": {
              "type": "string"
            },
            "query": {
              "type": "string"
            }
          },
          "required": [
            "model"
          ],
          "type": "object"
        }
      }
    },
    "SyncService.watch.output": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "string"
        },
        "heartbeat": {
          "default": false,
          "description": "Keep-alive of an idle watch: clients must not pull on it",
          "type": "boolean"
        }
      },
      "required": [
        "cursor"
      ],
      "type": "object",
      "x-webda-stream": true
    }
  },
  "behaviors": {}
}