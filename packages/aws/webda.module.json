{
  "$schema": "https://webda.io/schemas/webda.module.v4.json",
  "beans": {},
  "deployers": {},
  "moddas": {
    "Webda/AWSCommands": {
      "Import": "lib/services/awscommands.service:AWSCommands",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "description": "Interface to specify the Service parameters",
        "properties": {
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "type"
        ],
        "type": "object",
        "title": "AWSCommands"
      },
      "Configuration": "node_modules/@webda/core/lib/services/serviceparameters:ServiceParameters",
      "commands": {
        "aws route53 export": {
          "description": "Export a Route53 domain to a json file",
          "method": "route53Export",
          "args": {
            "domain": {
              "type": "string",
              "required": true
            },
            "file": {
              "type": "string",
              "required": true
            }
          },
          "requires": [
            "aws-commands"
          ],
          "phase": "resolved"
        },
        "aws route53 import": {
          "description": "Import a Route53 exported format to Route53",
          "method": "route53Import",
          "args": {
            "file": {
              "type": "string",
              "required": true
            }
          },
          "requires": [
            "aws-commands"
          ],
          "phase": "resolved"
        },
        "aws route53 sync": {
          "description": "Sync a Route53 exported format to Route53 (remove all others entries)",
          "method": "route53Sync",
          "args": {
            "file": {
              "type": "string",
              "required": true
            },
            "pretend": {
              "type": "boolean",
              "default": false
            }
          },
          "requires": [
            "aws-commands"
          ],
          "phase": "resolved"
        },
        "aws copyTable": {
          "description": "Copy a DynamoDB table content to another table",
          "method": "copyTable",
          "args": {
            "sourceTable": {
              "type": "string",
              "required": true
            },
            "targetTable": {
              "type": "string",
              "required": true
            }
          },
          "requires": [
            "aws-commands"
          ],
          "phase": "resolved"
        }
      }
    },
    "Webda/AWSSecretsManager": {
      "Import": "lib/services/secretsmanager.service:default",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "credentials": {
            "additionalProperties": false,
            "description": "Static credentials, default to the AWS environment variables",
            "properties": {
              "accessKeyId": {
                "type": "string"
              },
              "secretAccessKey": {
                "type": "string"
              },
              "sessionToken": {
                "type": "string"
              }
            },
            "required": [
              "accessKeyId",
              "secretAccessKey"
            ],
            "type": "object"
          }
        },
        "description": "AWS SecretsManager parameters",
        "properties": {
          "credentials": {
            "$ref": "#/definitions/credentials",
            "description": "Static credentials, default to the AWS environment variables"
          },
          "endpoint": {
            "description": "Custom endpoint (localstack, minio, ...)",
            "type": "string"
          },
          "region": {
            "default": "us-east-1",
            "description": "AWS region",
            "type": "string"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "type"
        ],
        "type": "object",
        "title": "AWSSecretsManager"
      },
      "Configuration": "lib/services/secretsmanager.service:AWSSecretsManagerParameters"
    },
    "Webda/CloudWatchLogger": {
      "Import": "lib/services/cloudwatchlogger.service:CloudWatchLogger",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "credentials": {
            "additionalProperties": false,
            "description": "Static credentials, default to the AWS environment variables",
            "properties": {
              "accessKeyId": {
                "type": "string"
              },
              "secretAccessKey": {
                "type": "string"
              },
              "sessionToken": {
                "type": "string"
              }
            },
            "required": [
              "accessKeyId",
              "secretAccessKey"
            ],
            "type": "object"
          }
        },
        "description": "Send webda log to CloudWatch",
        "properties": {
          "CloudFormation": {
            "description": "CloudFormation customization"
          },
          "CloudFormationSkip": {
            "default": false,
            "description": "Skip CloudFormation on deploy",
            "type": "boolean"
          },
          "credentials": {
            "$ref": "#/definitions/credentials",
            "description": "Static credentials, default to the AWS environment variables"
          },
          "endpoint": {
            "description": "Custom endpoint (localstack, minio, ...)",
            "type": "string"
          },
          "kmsKeyId": {
            "description": "KMS key to use when creating the log group",
            "type": "string"
          },
          "logGroupName": {
            "description": "logGroupName to send logStream to",
            "type": "string"
          },
          "logLevel": {
            "default": "INFO",
            "description": "Minimum level of logs to send",
            "enum": [
              "ERROR",
              "WARN",
              "INFO",
              "DEBUG",
              "TRACE"
            ],
            "type": "string"
          },
          "logStreamNamePrefix": {
            "description": "Prefix of the log stream name, a random uuid is appended",
            "type": "string"
          },
          "region": {
            "default": "us-east-1",
            "description": "AWS region",
            "type": "string"
          },
          "singlePush": {
            "default": false,
            "description": "Send each log line as soon as it is produced",
            "type": "boolean"
          },
          "tags": {
            "description": "Tags to add when creating the log group"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "logGroupName",
          "type"
        ],
        "type": "object",
        "title": "CloudWatchLogger"
      },
      "Configuration": "lib/services/cloudwatchlogger.service:CloudWatchLoggerParameters"
    },
    "Webda/DynamoStore": {
      "Import": "lib/services/dynamodb.service:DynamoStore",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "DynamoGlobalIndexes": {
            "additionalProperties": {
              "$ref": "#/definitions/globalIndexes%24%5Bkey%3A%20string%5D"
            },
            "description": "DynamoDB global secondary indexes definition",
            "type": "object"
          },
          "credentials": {
            "additionalProperties": false,
            "description": "Static credentials, default to the AWS environment variables",
            "properties": {
              "accessKeyId": {
                "type": "string"
              },
              "secretAccessKey": {
                "type": "string"
              },
              "sessionToken": {
                "type": "string"
              }
            },
            "required": [
              "accessKeyId",
              "secretAccessKey"
            ],
            "type": "object"
          },
          "globalIndexes$[key: string]": {
            "additionalProperties": false,
            "properties": {
              "key": {
                "description": "Hash key of the index",
                "type": "string"
              },
              "sort": {
                "description": "Range key of the index",
                "type": "string"
              }
            },
            "required": [
              "key"
            ],
            "type": "object"
          },
          "modelAliases": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Model Aliases to allow easier rename of Model",
            "type": "object"
          },
          "tables": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Per-model table name overrides, keyed by model identifier\n\nModels not listed use `table`",
            "type": "object"
          }
        },
        "description": "Define DynamoDB parameters",
        "properties": {
          "CloudFormation": {
            "description": "CloudFormation customization"
          },
          "CloudFormationSkip": {
            "default": false,
            "description": "Skip CloudFormation on deploy",
            "type": "boolean"
          },
          "credentials": {
            "$ref": "#/definitions/credentials",
            "description": "Static credentials, default to the AWS environment variables"
          },
          "defaultModel": {
            "default": true,
            "description": "When __type model not found, use the model\nIf strict is setup this parameter is not used",
            "type": "boolean"
          },
          "endpoint": {
            "description": "Custom endpoint (localstack, minio, ...)",
            "type": "string"
          },
          "forceModel": {
            "default": false,
            "description": "If set, Store will ignore the __type",
            "type": "boolean"
          },
          "globalIndexes": {
            "$ref": "#/definitions/DynamoGlobalIndexes",
            "description": "Additional global indexes"
          },
          "modelAliases": {
            "$ref": "#/definitions/modelAliases",
            "description": "Model Aliases to allow easier rename of Model"
          },
          "models": {
            "default": [
              "Webda/RegistryEntry"
            ],
            "description": "Models managed by this Store.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "noCache": {
            "default": false,
            "description": "Disable default memory cache",
            "type": "boolean"
          },
          "region": {
            "default": "us-east-1",
            "description": "AWS region",
            "type": "string"
          },
          "scanPage": {
            "description": "Number of items to retrieve per scan page",
            "type": "number"
          },
          "slowQueryThreshold": {
            "default": 30000,
            "description": "Slow query threshold",
            "type": "number"
          },
          "strict": {
            "default": false,
            "description": "Allow to load object that does not have the type data\n\nIf set to true, then the Store will only managed the defined _model and no\nmodel extending this one",
            "type": "boolean"
          },
          "table": {
            "description": "Table name",
            "type": "string"
          },
          "tables": {
            "$ref": "#/definitions/tables",
            "description": "Per-model table name overrides, keyed by model identifier\n\nModels not listed use `table`"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "table",
          "type"
        ],
        "type": "object",
        "title": "DynamoStore"
      },
      "Configuration": "lib/services/dynamodb.service:DynamoStoreParameters"
    },
