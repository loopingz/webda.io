{
  "$schema": "https://webda.io/schemas/webda.module.v4.json",
  "beans": {},
  "deployers": {},
  "moddas": {
    "Webda/MongoStore": {
      "Import": "lib/mongodb.service:MongoStore",
      "Schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "DbOptions": {
            "additionalProperties": false,
            "properties": {
              "authSource": {
                "description": "If the database authentication is dependent on another databaseName.",
                "type": "string"
              },
              "bsonRegExp": {
                "default": false,
                "defaultValue": "`false`",
                "description": "return BSON regular expressions as BSONRegExp instances.",
                "type": "boolean"
              },
              "checkKeys": {
                "default": false,
                "defaultValue": "`false`",
                "description": "the serializer will check if keys are valid.",
                "type": "boolean"
              },
              "enableUtf8Validation": {
                "default": false,
                "description": "Enable utf8 validation when deserializing BSON documents.  Defaults to true.",
                "type": "boolean"
              },
              "fieldsAsRaw": {
                "$ref": "#/definitions/Document",
                "defaultValue": "`null`",
                "description": "allow to specify if there what fields we wish to return as unserialized raw buffer."
              },
              "forceServerObjectId": {
                "default": false,
                "description": "Force server to assign _id values instead of driver.",
                "type": "boolean"
              },
              "ignoreUndefined": {
                "default": false,
                "defaultValue": "`true`",
                "description": "serialize will not emit undefined fields\nnote that the driver sets this to `false`",
                "type": "boolean"
              },
              "pkFactory": {
                "$ref": "#/definitions/PkFactory",
                "description": "A primary key factory object for generation of custom _id keys."
              },
              "promoteBuffers": {
                "default": false,
                "defaultValue": "`false`",
                "description": "when deserializing a Binary will return it as a node.js Buffer instance.",
                "type": "boolean"
              },
              "promoteLongs": {
                "default": false,
                "defaultValue": "`true`",
                "description": "when deserializing a Long will fit it into a Number if it's smaller than 53 bits.",
                "type": "boolean"
              },
              "promoteValues": {
                "default": false,
                "defaultValue": "`true`",
                "description": "when deserializing will promote BSON values to their Node.js closest equivalent types.",
                "type": "boolean"
              },
              "raw": {
                "default": false,
                "description": "Enabling the raw option will return a [Node.js Buffer](https://nodejs.org/api/buffer.html)\nwhich is allocated using [allocUnsafe API](https://nodejs.org/api/buffer.html#static-method-bufferallocunsafesize).\nSee this section from the [Node.js Docs here](https://nodejs.org/api/buffer.html#what-makes-bufferallocunsafe-and-bufferallocunsafeslow-unsafe)\nfor more detail about what \"unsafe\" refers to in this context.\nIf you need to maintain your own editable clone of the bytes returned for an extended life time of the process, it is recommended you allocate\nyour own buffer and clone the contents:",
                "example": "```ts\nconst raw = await collection.findOne({}, { raw: true });\nconst myBuffer = Buffer.alloc(raw.byteLength);\nmyBuffer.set(raw, 0);\n// Only save and use `myBuffer` beyond this point\n```",
                "remarks": "Please note there is a known limitation where this option cannot be used at the MongoClient level (see [NODE-3946](https://jira.mongodb.org/browse/NODE-3946)).\nIt does correctly work at `Db`, `Collection`, and per operation the same as other BSON options work.",
                "type": "boolean"
              },
              "readConcern": {
                "$ref": "#/definitions/Document",
                "description": "Specify a read concern for the collection. (only MongoDB 3.2 or higher supported)"
              },
              "readPreference": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/Document"
                  },
                  {
                    "const": "primary",
                    "type": "string"
                  },
                  {
                    "const": "primaryPreferred",
                    "type": "string"
                  },
                  {
                    "const": "secondary",
                    "type": "string"
                  },
                  {
                    "const": "secondaryPreferred",
                    "type": "string"
                  },
                  {
                    "const": "nearest",
                    "type": "string"
                  }
                ],
                "description": "The preferred read preference (ReadPreference.PRIMARY, ReadPreference.PRIMARY_PREFERRED, ReadPreference.SECONDARY, ReadPreference.SECONDARY_PREFERRED, ReadPreference.NEAREST).",
                "public": true
              },
              "retryWrites": {
                "default": false,
                "description": "Should retry failed writes",
                "type": "boolean"
              },
              "serializeFunctions": {
                "default": false,
                "defaultValue": "`false`",
                "description": "serialize the javascript functions",
                "type": "boolean"
              },
              "timeoutMS": {
                "experimental": "Specifies the time an operation will run until it throws a timeout error",
                "type": "number"
              },
              "useBigInt64": {
                "default": false,
                "defaultValue": "`false`",
                "description": "when deserializing a Long return as a BigInt.",
                "type": "boolean"
              },
              "writeConcern": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/WriteConcern"
                  },
                  {
                    "$ref": "#/definitions/WriteConcernSettings"
                  }
                ],
                "description": "Write Concern as an object"
              }
            },
            "public": true,
            "type": "object"
          },
          "Document": {
            "additionalProperties": {},
            "public": true,
            "type": "object"
          },
          "PkFactory": {
            "additionalProperties": false,
            "public": true,
            "type": "object"
          },
          "WriteConcern": {
            "additionalProperties": false,
            "description": "A MongoDB WriteConcern, which describes the level of acknowledgement\nrequested from MongoDB for write operations.",
            "properties": {
              "fsync": {
                "deprecated": true,
                "description": "Equivalent to the j option.",
                "enum": [
                  false,
                  true,
                  1
                ],
                "type": [
                  "boolean",
                  "number"
                ]
              },
              "j": {
                "default": false,
                "deprecated": true,
                "description": "Request acknowledgment that the write operation has been written to the on-disk journal.",
                "type": "boolean"
              },
              "wtimeout": {
                "deprecated": true,
                "description": "Specify a time limit to prevent write operations from blocking indefinitely.",
                "type": "number"
              }
            },
            "public": true,
            "see": "https://www.mongodb.com/docs/manual/reference/write-concern/",
            "type": "object"
          },
          "WriteConcernSettings": {
            "additionalProperties": false,
            "properties": {
              "fsync": {
                "deprecated": true,
                "description": "The file sync write concern.",
                "enum": [
                  false,
                  true,
                  1
                ],
                "type": [
                  "boolean",
                  "number"
                ]
              },
              "j": {
                "default": false,
                "deprecated": true,
                "description": "The journal write concern.",
                "type": "boolean"
              },
              "journal": {
                "default": false,
                "description": "The journal write concern",
                "type": "boolean"
              },
              "w": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "const": "majority",
                    "type": "string"
                  }
                ],
                "description": "The write concern",
                "public": true
              },
              "wtimeout": {
                "description": "The write concern timeout.",
                "type": "number"
              },
              "wtimeoutMS": {
                "description": "The write concern timeout.",
                "type": "number"
              }
            },
            "public": true,
            "type": "object"
          },
          "modelAliases": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Model Aliases to allow easier rename of Model",
            "type": "object"
          }
        },
        "description": "MongoDB store parameters",
        "properties": {
          "collection": {
            "description": "Which collection to use\n\nAll the models managed by the store share this collection, the `__type`\nfield is used to differentiate them",
            "type": "string"
          },
          "database": {
            "description": "Database to use, default to the one defined in the URL",
            "type": "string"
          },
          "databaseOptions": {
            "$ref": "#/definitions/DbOptions",
            "description": "Mongo Database Options",
            "see": "https://www.npmjs.com/package/mongodb"
          },
          "defaultModel": {
            "default": true,
            "description": "When __type model not found, use the model\nIf strict is setup this parameter is not used",
            "type": "boolean"
          },
          "forceModel": {
            "default": false,
            "description": "If set, Store will ignore the __type",
            "type": "boolean"
          },
          "modelAliases": {
            "$ref": "#/definitions/modelAliases",
            "description": "Model Aliases to allow easier rename of Model"
          },
          "models": {
            "default": [
              "Webda/RegistryEntry"
            ],
            "description": "Models managed by this Store.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "mongoUrl": {
            "description": "Contains the URL to Mongo Server\n\nWill try to use WEBDA_MONGO_URL environment variable if not defined",
            "type": "string"
          },
          "noCache": {
            "default": false,
            "description": "Disable default memory cache",
            "type": "boolean"
          },
          "options": {
            "description": "Additional options for Mongo connetion\n\nShould be typed with MongoClientOptions but not available due to bug in ts-json-schema-generator\nhttps://docs.mongodb.com/manual/reference/connection-string"
          },
          "slowQueryThreshold": {
            "default": 30000,
            "description": "Slow query threshold",
            "type": "number"
          },
          "strict": {
            "default": false,
            "description": "Allow to load object that does not have the type data\n\nIf set to true, then the Store will only managed the defined _model and no\nmodel extending this one",
            "type": "boolean"
          },
          "type": {
            "description": "Type of the service",
            "type": "string"
          },
          "openapi": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "collection",
          "type"
        ],
        "type": "object",
        "title": "MongoStore"
      },
      "Configuration": "lib/mongodb.service:MongoParameters"
    }
  },
  "models": {},
  "schemas": {
    "Webda/BinaryFile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "WebdaSchema": true,
      "additionalProperties": false,
      "description": "Represent a file to store",
      "properties": {
        "challenge": {
          "description": "Will be computed by the service\n\nhash of the content prefixed by 'WEBDA'",
          "type": "string"
        },
        "hash": {
          "description": "Will be computed by the service\n\nhash of the content",
          "type": "string"
        },
        "metadata": {
          "description": "Metadatas stored along with the binary"
        },
        "mimetype": {
          "description": "Mimetype of the binary",
          "type": "string"
        },
        "name": {
          "description": "Current name",
          "type": "string"
        },
        "originalname": {
          "description": "Original name",
          "type": "string"
        },
        "size": {
          "description": "Size of the binary",
          "type": "number"
        }
      },
      "required": [
        "mimetype",
        "name",
        "size"
      ],
      "type": "object",
      "title": "BinaryFile"
    }
  },
  "behaviors": {},
  "sourceDigest": "12f4e4000766c730e58d788fa9c00d65"
}