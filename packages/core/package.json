{
  "name": "@webda/core",
  "version": "4.0.0-beta.12",
  "description": "Expose API with Lambda",
  "keywords": [
    "aws",
    "lamda",
    "api gateway"
  ],
  "author": "Remi Cattiau <remi@cattiau.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopingz/webda.io.git",
    "directory": "packages/core"
  },
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "bin": {
    "webda": "./lib/bin/launcher.js"
  },
  "scripts": {
    "build": "webdac build",
    "build:watch": "webdac build --watch",
    "deps:graph": "skott --showCircularDependencies --no-trackTypeOnlyDependencies --displayMode=raw -e .ts",
    "format": "prettier --check src/**/*",
    "format:fix": "prettier --write src/**/*",
    "typecheck:sealed": "tsc -p tsconfig.sealed-dom.json",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:debug": "vitest --inspect-brk --test-timeout=0 --no-file-parallelism",
    "test:seq": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@types/json-schema": "^7.0.15",
    "@webda/cache": "workspace:^",
    "@webda/decorators": "workspace:^",
    "@webda/models": "workspace:^",
    "@webda/ql": "workspace:*",
    "@webda/utils": "workspace:^",
    "@webda/workout": "workspace:*",
    "accept-language": "^3.0.20",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "antlr4ts": "0.5.0-alpha.4",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "dateformat": "^5.0.5",
    "deepmerge-ts": "^8.0.2",
    "glob": "^14.0.3",
    "global": "^4.4.0",
    "hash-wasm": "^4.12.0",
    "is-in-subnet": "^4.0.1",
    "json-schema": "^0.4.0",
    "jsonc-parser": "^3.3.1",
    "jsondiffpatch": "^0.7.7",
    "jsonpath": "^1.3.0",
    "jsonwebtoken": "^9.0.3",
    "merge": "^2.1.1",
    "mime-types": "^3.0.2",
    "node-cron": "^4.6.0",
    "node-machine-id": "^1.1.12",
    "openapi-types": "^12.1.3",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.18.1",
    "semver": "^7.8.6",
    "stream-buffers": "^3.0.3",
    "ts-json-schema-generator": "^2.9.0",
    "ts-method-cache": "^3.3.1",
    "uri-templates": "^0.2.0",
    "ws": "^8.22.1",
    "yaml": "^2.9.1",
    "yargs": "^18.2.0"
  },
  "peerDependencies": {
    "@webda/test": "workspace:^",
    "sinon": "^21.0.3",
    "vitest": "^4.1.2"
  },
  "peerDependenciesMeta": {
    "sinon": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "@webda/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/ws": "^8.18.2",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-istanbul": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@webda/compiler": "workspace:^",
    "@webda/content-mapper": "workspace:^",
    "@webda/test": "workspace:^",
    "axios": "^1.21.0",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "fs-extra": "^11.4.1",
    "jest": "^30.5.2",
    "jose": "^6.2.15",
    "jscodeshift": "^17.4.0",
    "prettier": "^3.9.10",
    "sinon": "^22.1.0",
    "skott": "^0.35.12",
    "source-map-support": "^0.5.21",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-dev.20261102.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "files": [
    "lib",
    "test",
    "webda.module.json"
  ],
  "c8": {
    "report-dir": "./reports",
    "reporter": [
      "html",
      "lcov",
      "json"
    ],
    "exclude": [
      "hooks.mjs",
      "hooks-register.mjs",
      "lib/**/*",
      "src/test.ts",
      "**/*.spec.ts",
      "test/**/*",
      "*/stores/webdaql/WebdaQL*"
    ],
    "excludeNodeModules": true
  },
  "homepage": "https://webda.io",
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "implicitDependencies": [
      "@webda/workout"
    ]
  },
  "webda": {
    "namespace": "Webda",
    "capabilities": {
      "router": "Webda/Router",
      "rest-domain": "Webda/RESTOperationsTransport",
      "http-server": "Webda/HttpServer"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "LGPL-3.0-only"
}
